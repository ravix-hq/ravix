# Loaded by direnv on entering this directory. Holds no credentials itself: it
# reads `.env`, which is gitignored and generated by `mix mcp.env` from
# Infisical. Run `direnv allow` once to trust this file.
#
# This exists because Claude Code expands `${VAR}` in `.mcp.json` from the
# *process* environment and does not read `.env` -- so something has to put the
# values there before `claude` starts. `infisical run --env=dev -- claude` is
# the alternative that keeps nothing on disk.
dotenv_if_exists .env
