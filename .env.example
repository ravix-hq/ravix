# Credentials for the MCP servers declared in `.mcp.json`. Copy to `.env` --
# which is gitignored -- or generate it from Infisical:
#
#   mix mcp.env          # writes .env from Infisical's ravix/dev
#
# `direnv` loads `.env` into the shell through `.envrc`, and Claude Code expands
# these into `.mcp.json` from the process environment. It does NOT read `.env`
# itself, so the file has to be loaded before `claude` starts.
#
# See the README's "Agent tooling (MCP)" for which key each one wants: they are
# three different credentials, and two of them are easy to confuse with keys
# that already exist for the application.

# PostHog personal API key, MCP Server preset, in the account owning Ravix's project.
RAVIX_POSTHOG_MCP_KEY=

# Honeycomb Management API key, as KEY_ID:SECRET joined by a colon.
# Not the ingest key the application sends traces with.
RAVIX_HONEYCOMB_MCP_KEY=

# Render API key for the account owning the `ravix` service.
# Reaches every workspace that account belongs to, and can trigger deploys.
RAVIX_RENDER_MCP_KEY=
