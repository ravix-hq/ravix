<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="description"
      content="Ravix: a browser workspace for building software with coding agents. Sign in with GitHub, pick a repository, and every piece of work gets its own branch, its own files and its own agent on one persistent cloud machine."
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link rel="icon" type="image/png" href={~p"/favicon.ico"} />
    <.live_title default="Ravix">{assigns[:page_title]}</.live_title>
    <script src={~p"/theme.js"}>
    </script>
    <link
      rel="preload"
      href={~p"/fonts/IBMPlexSans-Regular.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={~p"/fonts/IBMPlexMono-Regular.woff2"}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    <div id="request-progress" role="status" aria-live="polite">
      <span class="sr-only">Waiting for a response…</span>
    </div>
    {@inner_content}
  </body>
</html>
