<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<title>Starting preview · Ravix</title>
<style>
:root{color-scheme:dark;font:16px/1.6 system-ui,sans-serif;background:#0c0d0f;color:#e6e8ec}
*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px}
main{width:min(100%,640px)}h1{font-size:24px;font-weight:600;margin:0 0 24px}
.loading-status{display:flex;align-items:center;gap:12px;color:#8e939c}
.loading-spinner{display:inline-block;flex:none;width:22px;height:22px;border:2px solid #34383f;border-top-color:#7ea8ff;border-radius:50%;animation:spin .8s linear infinite}
[hidden]{display:none!important}details{margin:24px 0;border:1px solid #34383f;border-radius:8px;background:#121316}
summary{padding:12px 16px;cursor:pointer}pre{margin:0;padding:16px;border-top:1px solid #34383f;max-height:320px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;font:13px/1.6 ui-monospace,monospace}
a{color:#7ea8ff}a:focus-visible,summary:focus-visible{outline:2px solid #7ea8ff;outline-offset:4px}
#error{color:#ff9e9e}footer{margin-top:24px}@keyframes spin{to{transform:rotate(360deg)}}
@media(prefers-reduced-motion:reduce){.loading-spinner{animation:none}}
</style>
</head>
<body>
<main>
<h1>Live working copy</h1>
<p id="loader" class="loading-status" role="status"><span class="loading-spinner" aria-hidden="true"></span><span id="state"><%= escape(label) %></span></p>
<p id="error" role="alert" hidden></p>
<details id="log-disclosure"><summary>Show logs</summary><pre id="logs">No logs yet.</pre></details>
<footer><a href="<%= escape(back) %>">Back to track · send a correction</a></footer>
</main>
<script>
const loader=document.querySelector('#loader'), state=document.querySelector('#state');
const error=document.querySelector('#error'), disclosure=document.querySelector('#log-disclosure');
const logs=document.querySelector('#logs'), label=state.textContent;
function fail(message){
  loader.hidden=true;error.hidden=false;error.textContent=message;disclosure.open=true;
}
async function poll(){
  try{
    const response=await fetch('/__ravix/status');
    if(!response.ok){fail('Access ended. Return to the track.');return;}
    const preview=await response.json();
    if(preview.state==='ready'){location.replace('/');return;}
    logs.textContent=(preview.logs||'').slice(-32000)||'No logs yet.';
    if(preview.state==='failed'){fail(preview.error||'The preview could not start.');return;}
    state.textContent=label;
    setTimeout(poll,1000);
  }catch(_){
    state.textContent='Reconnecting to the preview…';
    setTimeout(poll,1000);
  }
}
poll();
</script>
</body>
</html>
