<Layouts.app flash={@flash} stale_assets={@static_changed?}>
  <main :if={is_nil(@current_user)} class="centred signin-page">
    <div class="corner-theme"><.theme_picker id="signin-theme" /></div>
    <div class="signin-card">
      <div class="signin-mark"><.wordmark size={32} /></div>
      <h1>Sign in to Ravix</h1>
      <p class="lede">Share the running version, and keep working on it together.</p>
      <ul class="points">
        <li>
          <.icon name="globe" size={14} class="ico" />
          <span>
            <strong>A live preview</strong>
            <small>The app is already running when someone opens it.</small>
          </span>
        </li>
        <li>
          <.icon name="add-person" size={14} class="ico" />
          <span>
            <strong>One conversation</strong>
            <small>The next change stays in the same thread.</small>
          </span>
        </li>
        <li>
          <.icon name="machine" size={14} class="ico" />
          <span>
            <strong>A cloud machine</strong>
            <small>The work continues after you close the laptop.</small>
          </span>
        </li>
      </ul>
      <a
        :if={@github_available}
        class="landing-button landing-primary gh-button"
        href="/auth/github"
      >
        <.icon name="github" size={17} />Sign in with GitHub
      </a>
      <p :if={!@github_available} class="error">
        GitHub sign-in is not configured for this deployment. Contact the person who runs it to get access.
      </p>
    </div>
  </main>
  <div :if={@current_user} class="app" id="workspace-navigation" phx-hook="QuickJump">
    <%!-- The frame is a code host's dashboard: a bar across the top (home,
      the workspace switcher, search, Add a repository, New track, and you)
      and a sidebar down the left (whose workspace this is, where to go, the
      tracks that are open, Settings). Projects are Home's list; a project's
      tracks are its own page. On a phone the sidebar goes and the bar keeps
      the places to go. --%>
    <header id="topbar" class="topbar">
      <.link patch="/home" class="topbar-home" aria-label="Ravix home" data-tip="Home">
        <.icon name="branch" size={26} class="topbar-logo" />
        <span :if={is_nil(@project)}>Ravix</span>
      </.link>
      <%!-- Inside a project the bar is where you are: the workspace, the
        project and, on a track, its tracks. Everywhere else it is the
        workspace, search and the places to go. --%>
      <nav :if={@project} class="topbar-crumbs" aria-label="Breadcrumb">
        <%!-- Until the rail answers, which workspace the project is in is
          not known: a placeholder, never a guess. --%>
        <.link :if={@rail_loaded} patch="/home">
          {workspace_name(@current_workspace, @current_user)}
        </.link>
        <span
          :if={!@rail_loaded}
          id="crumb-workspace-loading"
          class="skeleton crumb-skeleton"
          aria-hidden="true"
        ></span>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <.link
          patch={"/p/#{@project.id}"}
          aria-current={if is_nil(@track_id), do: "page"}
          class={is_nil(@track_id) && "here"}
        >
          <.project_name project={@project} within={within(@current_workspace)} />
        </.link>
        <span :if={@track_id} class="crumb-sep" aria-hidden="true">/</span>
        <span :if={@track_id} class="dim">Tracks</span>
        <span :if={is_nil(@track_id)} class="chip">
          {if @project.repo_private, do: "Private", else: "Public"}
        </span>
      </nav>
      <span :if={@project} class="spacer"></span>
      <%!-- Inside a project the bar has no places to go, but the Inbox count
        still says when something needs you. --%>
      <.link
        :if={@project}
        id="topbar-inbox"
        patch="/inbox"
        class="topbar-item"
        aria-label={if @attention > 0, do: "Inbox, #{@attention} need you", else: "Inbox"}
      >
        <.icon name="terminal" size={15} />Inbox<span :if={@attention > 0} class="badge">{@attention}</span>
      </.link>
      <.icon_button
        :if={@project}
        id="quick-jump-trigger"
        icon="search"
        size={16}
        label="Search"
        tip="Search projects, tracks and plans"
        shortcut="Mod+K"
        class="ghost"
        aria-keyshortcuts={if @mac, do: "Meta+K", else: "Control+K"}
        data-quick-jump-trigger
        phx-click={JS.push_focus() |> JS.push("dialog")}
        phx-value-name="search"
      />
      <RavixWeb.Live.WorkspaceSwitcher.switcher
        :if={is_nil(@project) && @workspaces != []}
        workspaces={@workspaces}
        current_id={@current_workspace && @current_workspace.workspace.id}
      />
      <span :if={is_nil(@project) && @workspaces == []} class="topbar-workspace">
        <span class="workspace-mark" aria-hidden="true">
          {workspace_name(@current_workspace, @current_user)
          |> String.trim_leading("@")
          |> String.first()
          |> String.upcase()}
        </span>
        {workspace_name(@current_workspace, @current_user)}
      </span>
      <button
        :if={is_nil(@project)}
        id="quick-jump-trigger"
        type="button"
        class="topbar-search"
        data-tip="Search projects, tracks and plans"
        data-tip-kbd="Mod+K"
        aria-keyshortcuts={if @mac, do: "Meta+K", else: "Control+K"}
        data-quick-jump-trigger
        phx-click={JS.push_focus() |> JS.push("dialog")}
        phx-value-name="search"
      >
        <.icon name="search" size={16} /><span>Search projects, tracks, threads…</span>
        <kbd aria-hidden="true">{if @mac, do: "⌘K", else: "Ctrl K"}</kbd>
      </button>
      <nav :if={is_nil(@project)} class="topbar-nav" aria-label="Workspace">
        <.link
          patch="/home"
          class={["topbar-item", @live_action == :projects && "on"]}
          aria-current={@live_action == :projects && "page"}
        >
          Projects
        </.link>
        <.link
          patch="/inbox"
          class={["topbar-item", @live_action in [:home, :inbox] && "on"]}
          aria-current={@live_action in [:home, :inbox] && "page"}
        >
          Inbox<span :if={@attention > 0} class="badge">{@attention}</span>
        </.link>
        <.link
          patch="/schedules"
          class={["topbar-item", @live_action == :schedules && "on"]}
          aria-current={@live_action == :schedules && "page"}
        >
          Schedules
        </.link>
      </nav>
      <button
        id="top-new-track"
        class="primary"
        data-new-track-trigger
        aria-keyshortcuts="Control+N Meta+N"
        data-tip="New track"
        data-tip-kbd="Mod+N"
        phx-click={new_track_click(@rail_loaded, @projects)}
      >
        <.icon name="plus" />New track
      </button>
      <button
        type="button"
        id="account-trigger"
        class="topbar-account"
        aria-label={"You" <> unseen_note(@changes_unseen, ", ")}
        data-tip={"You" <> unseen_note(@changes_unseen, " · ")}
        popovertarget="account-menu"
      >
        <%!-- The dot (RAV-96): What's new has entries this person has not
          opened, and opening it clears the dot. The button's name and
          tooltip both say so. --%>
        <span class="account-icon">
          <img
            :if={@current_user.avatar_url}
            src={@current_user.avatar_url}
            alt=""
            width="32"
            height="32"
          />
          <span :if={!@current_user.avatar_url} aria-hidden="true">
            {@current_user.login |> String.slice(0, 2) |> String.upcase()}
          </span>
          <span
            :if={@changes_unseen > 0}
            class="account-unseen"
            id="account-unseen"
            aria-hidden="true"
          ></span>
        </span>
        <span class="sr-only">Account menu, @{@current_user.login}</span>
      </button>
      <div id="account-menu" class="account-menu" popover aria-label="You">
        <%!-- Quick toggles, then Settings (RAV-77): Profile, Agents,
          Notifications, Appearance and Connected apps are its pages. The two
          toggles and their pages' switches keep each other current. --%>
        <.theme_picker id="theme-picker" />
        <div id="notify" phx-hook="Notify" class="notify">
          <button
            type="button"
            class="theme-trigger"
            data-notify-toggle
            aria-pressed="false"
            title="Say so from the desktop when a track needs you and this tab is in the background"
          >
            <span class="notify-dot" data-notify-dot></span><span class="col"><small>Notifications</small><span
              class="truncate"
              data-notify-state
            >Off</span></span>
          </button>
        </div>
        <hr />
        <button
          type="button"
          class="account-item"
          id="open-personal-settings"
          popovertarget="account-menu"
          popovertargetaction="hide"
          phx-click={JS.patch(Settings.section_path(:personal, nil, Settings.first(:personal)))}
          data-leaves-page
        >
          <.icon name="settings" size={14} />Settings
        </button>
        <button
          type="button"
          class="account-item"
          id="open-help"
          popovertarget="account-menu"
          popovertargetaction="hide"
          phx-click={JS.push_focus(to: "#account-trigger") |> JS.push("dialog")}
          phx-value-name="help"
        >
          <.icon name="info" size={14} />Help
        </button>
        <button
          type="button"
          class="account-item"
          id="open-changes"
          popovertarget="account-menu"
          popovertargetaction="hide"
          phx-click={JS.push_focus(to: "#account-trigger") |> JS.push("dialog")}
          phx-value-name="changes"
          aria-label="What's new"
        >
          <.icon name="sparkle" size={14} />What's new<span class="spacer"></span><span
            :if={@changes_unseen > 0}
            class="badge"
          >{@changes_unseen}</span>
        </button>
        <hr />
        <.link href="/auth/signout" method="post" class="account-item">
          <.icon name="sign-out" size={14} />Sign out
        </.link>
      </div>
    </header>
    <main class="stage" id="workspace-stage">
      <div
        class="workspace-tabpanel"
        id="project-tabpanel"
        role={@project && "region"}
        aria-label={@project && @project.display_name}
        tabindex={@project && "0"}
      >
        <%!-- The project's own page reads like a repository's: its name, the
          repository it is, and tabs for what is in it. Tracks is the page
          itself; People and Settings open the settings frame (RAV-74). --%>
        <header
          :if={@project && is_nil(@track_id) && is_nil(@settings)}
          class="crumbs repo-head"
        >
          <%!-- The project's name and repository are the top bar's breadcrumb;
            this is the tab bar under it. --%>
          <h1 class="sr-only">
            <.project_name project={@project} within={within(@current_workspace)} />
          </h1>
          <nav class="repo-tabs" aria-label="Project">
            <.link
              id="crumb-tracks"
              patch={"/p/#{@project.id}"}
              aria-current={if @live_action != :plans, do: "page"}
            >
              <.icon name="branch" size={14} />Tracks
              <span class="count">{length(@tracks[@project.id] || [])}</span>
            </.link>
            <.link
              :if={@project.access != :tracks && @live_action != :plans}
              id="crumb-plans"
              patch={"/p/#{@project.id}/plans"}
            >
              <.icon name="document" size={14} />Plans
            </.link>
            <span :if={@live_action == :plans} aria-current="page" class="current">
              <.icon name="document" size={14} />Plans
            </span>
            <%!-- The owner's People is the Access settings page (RAV-74);
              everyone else's is still the dialog. --%>
            <.link
              :if={@project.access != :tracks && @project.role == :owner}
              id="crumb-people"
              patch={"/p/#{@project.id}/settings/access"}
            >
              <.icon name="person" size={14} />People
            </.link>
            <button
              :if={@project.access != :tracks && @project.role != :owner}
              type="button"
              class="ghost"
              phx-click={JS.push_focus() |> JS.push("dialog")}
              phx-value-name="people"
            >
              <.icon name="person" size={14} />People
            </button>
            <.link
              :if={@project.access != :tracks && @project.role == :owner}
              id="crumb-agent"
              patch={"/p/#{@project.id}/settings/agent"}
            >
              <.icon name="sparkle" size={14} />Agent
            </.link>
            <.link
              :if={@project.access != :tracks && @project.role == :owner}
              id="crumb-settings"
              patch={"/p/#{@project.id}/settings/general"}
            >
              <.icon name="settings" size={14} />Settings
            </.link>
          </nav>
        </header>
        <p
          :if={@project && @project.role != :owner && is_nil(@track_id)}
          id="project-agent-owner"
          class="settings-help"
        >
          This project runs on {@project.owner_login}'s {RavixWeb.AgentName.label(
            @project.runtime
          )}; every turn uses their subscription or API key.
        </p>
        <div :if={@project && @track_id} class="workspace-track-host">
          <%!-- A fixed id, so choosing another track moves this LiveView instead
          of replacing it. The session is its starting point and nothing more:
          it is read once, at mount, and every switch after that arrives as
          `{:select_track, project, track}`. See `hand_over/4`. --%>
          {live_render(@socket, RavixWeb.TrackLive,
            id: "track-host",
            session: %{
              "session_token" => @session_token,
              "track_id" => @track_id,
              "project_id" => @project.id,
              "timezone" => @timezone
            }
          )}
        </div>
        <.live_component
          :if={@project && is_nil(@track_id) && is_nil(@settings)}
          module={RavixWeb.Live.AgentHealth}
          id={"project-agent-health-#{@project.id}"}
          current_user={@current_user}
          session_hash={@session_hash}
          project_id={@project.id}
          refresh={@health_refresh}
        />
        <%!-- Plans are a page of their own, reached from the project row. A
          `?plan=` or `?new=plan` link on the project itself still opens it,
          because track origins stored before the page existed point there. --%>
        <.live_component
          :if={
            @project && is_nil(@track_id) && @project.access != :tracks &&
              (@live_action == :plans || @selected_plan_id || @new_plan)
          }
          module={RavixWeb.Live.PlansPanel}
          id={"plans-#{@project.id}"}
          current_user={@current_user}
          session_hash={@session_hash}
          project={@project}
          plan_id={@selected_plan_id}
          new_plan={@new_plan}
          tracks={@tracks[@project.id] || []}
        />
        <div
          :if={
            @project && is_nil(@track_id) && @project.access == :tracks &&
              (@tracks[@project.id] || []) == []
          }
          class="workspace-project-empty"
        >
          <span class="empty-icon"><.icon name="machine" size={20} /></span>
          <h2>Pick a track</h2>
          <p>
            Each track is its own worktree on this project's machine, with its own branch and its own conversation.
          </p>
          <button
            :if={@project.access != :tracks}
            class="primary"
            phx-click={JS.push_focus() |> JS.push("dialog")}
            phx-value-name="new-track"
          >
            New track
          </button>
          <p :if={@project.access == :tracks}>
            Choose a track shared with you in the tabs above.
          </p>
        </div>
        <%!-- A project with no tracks yet starts one here; one with tracks
          shows them, as a branch graph or a list. --%>
        <section
          :if={
            @project && is_nil(@track_id) && @project.access != :tracks &&
              @live_action != :plans && is_nil(@selected_plan_id) && !@new_plan &&
              is_nil(@settings) && (@tracks[@project.id] || []) == [] &&
              !MapSet.member?(@closed_projects, @project.id) &&
              !MapSet.member?(@track_errors, @project.id)
          }
          id="project-start"
          class="first-prompt"
          aria-label="Start work in this project"
        >
          <QuickStart.composer
            id="project-quick-start"
            form={@quick_form}
            project={@project}
            busy={@quick_busy}
          />
          <QuickStart.explainer id="project-explainer" />
          <%!-- No open tracks is not no tracks: the closed ones are still
            here to find and reopen. --%>
          <button
            type="button"
            id="project-tracks-closed"
            class="ghost first-prompt-alt"
            aria-pressed="false"
            phx-click="show-closed"
            phx-value-project={@project.id}
            phx-value-show="true"
          >
            Show closed tracks
          </button>
        </section>
        <div
          :if={
            @project && is_nil(@track_id) && @live_action != :plans && is_nil(@settings) &&
              MapSet.member?(@track_errors, @project.id)
          }
          id="project-tracks-error"
          class="first-prompt"
          role="status"
        >
          <p>This project's tracks couldn't be loaded.</p>
          <button
            type="button"
            phx-click="retry-tracks"
            phx-value-id={@project.id}
            disabled={MapSet.member?(@track_loading, @project.id)}
          >{if MapSet.member?(@track_loading, @project.id), do: "Retrying…", else: "Retry"}</button>
        </div>
        <RavixWeb.Live.ProjectTracks.panel
          :if={
            @project && is_nil(@track_id) && @live_action != :plans &&
              is_nil(@selected_plan_id) && !@new_plan && is_nil(@settings) &&
              ((@tracks[@project.id] || []) != [] ||
                 MapSet.member?(@closed_projects, @project.id))
          }
          project={@project}
          tracks={@tracks[@project.id] || []}
          closed={
            if MapSet.member?(@closed_projects, @project.id),
              do:
                @closed_tracks[@project.id]
                |> Kernel.||([])
                |> Enum.take(closed_shown_count(@closed_pages, @project.id))
          }
          viewer={@current_user}
          more_closed={
            length(@closed_tracks[@project.id] || []) >
              closed_shown_count(@closed_pages, @project.id)
          }
          reopenable={reopenable?(@project)}
          view={@tracks_view}
          filter={@tracks_filter}
          people={@project_people}
          previews={Map.get(@previews, @project.id, [])}
          timezone={@timezone}
        />
        <%!-- Home (RAV-100), in the same page container as the Inbox and
          Schedules: sections and whose tracks to show at the side, the
          projects, and the recent tracks across them. Its action is New
          track, as in the top bar (RAV-37). --%>
        <%!-- Home (RAV-100), as a code host's dashboard: whose workspace and
          its sections at the side, the projects in the middle, and what is
          running and what needs you on the right. A first visit, with no
          projects yet, has the same frame: the form that starts one is the
          middle, its repositories listed as a code host lists them. --%>
        <div
          :if={is_nil(@project) && @live_action == :projects}
          id="home"
          class="home-dashboard"
        >
          <RavixWeb.Live.HomeProjects.side
            within={within(@current_workspace)}
            workspace={workspace_name(@current_workspace, @current_user)}
            kind={
              if @current_workspace && @current_workspace.workspace.kind == :team,
                do: "Team",
                else: "Personal"
            }
            count={length(@projects)}
            groups={home_groups(assigns)}
            selected={home_selected(assigns)}
            viewer={@current_user}
            active={home_active(assigns)}
            loaded={@rail_loaded}
          />
          <div class="home-main">
            <div
              :if={!@rail_loaded && !@rail_error}
              id="rail-loading"
              class="home-projects"
              role="status"
            >
              <span class="sr-only">Loading projects…</span>
              <span :for={_ <- 1..4} class="skeleton rail-row-skeleton" aria-hidden="true"></span>
            </div>
            <div :if={@rail_error} id="rail-error" class="home-projects" role="alert">
              <p>Projects could not be loaded.</p>
              <button type="button" phx-click="refresh">Retry</button>
            </div>
            <section
              :if={@rail_loaded && fresh_start?(@projects)}
              id="home-start"
              class="home-start"
              aria-labelledby="home-title"
            >
              <h1 id="home-title">Start your first track</h1>
              <p class="home-start-lede">
                Pick a repository and describe the change. Ravix opens a track, and your agent starts there.
              </p>
              <QuickStart.composer
                id="home-quick-start"
                form={@quick_form}
                groups={QuickStart.targets(@repos)}
                repos={@repos}
                add_repository
                loading={@repos_loading}
                busy={@quick_busy}
              />
              <QuickStart.explainer id="home-explainer" />
            </section>
            <RavixWeb.Live.HomeProjects.list
              :if={@rail_loaded && !fresh_start?(@projects)}
              within={within(@current_workspace)}
              heading={home_heading(assigns)}
              groups={home_groups(assigns)}
              tracks={@tracks}
              selected={home_selected(assigns)}
              sort={@home_sort}
              attention={Map.new(@projects, &{&1.id, project_attention(@tracks, &1.id)})}
              previews={@previews}
              errors={@track_errors}
              loading={@track_loading}
            />
          </div>
          <RavixWeb.Live.HomeProjects.activity
            :if={@rail_loaded}
            within={within(@current_workspace)}
            needs={home_needs(assigns)}
          />
        </div>
        <.live_component
          :if={@live_action == :schedules}
          module={RavixWeb.Live.SchedulesPanel}
          id="schedules"
          current_user={@current_user}
          timezone={@timezone}
          session_hash={@session_hash}
          projects={@all_projects}
        />
        <%!-- Settings pages, one URL a section (RAV-72). --%>
        <RavixWeb.Live.Settings.page
          :if={@settings}
          settings={@settings}
          project={@project}
          workspace={@current_workspace && @current_workspace.workspace}
          current_user={@current_user}
          session_hash={@session_hash}
        />
        <%!-- An address nothing answers, for somebody signed in: the page is
          still the app, with the top bar and a way on (RAV-100). The plug in
          front of the route has already set the 404. --%>
        <.stage_page :if={@live_action == :not_found} id="not-found" title_id="not-found-title">
          <:title>Page not found</:title>
          <:subtitle>
            Nothing is at this address. It may have moved, or the link may be incomplete.
          </:subtitle>
          <div class="page-actions">
            <.link id="not-found-inbox" patch="/inbox" class="button primary">Go to Inbox</.link>
            <button
              id="not-found-search"
              type="button"
              class="secondary"
              data-quick-jump-trigger
              phx-click={JS.push_focus() |> JS.push("dialog")}
              phx-value-name="search"
            >
              <.icon name="search" size={14} />Search
            </button>
          </div>
        </.stage_page>
        <.stage_page
          :if={
            is_nil(@project) &&
              @live_action not in [
                :projects,
                :schedules,
                :user_settings,
                :workspace_settings,
                :not_found
              ]
          }
          id="inbox"
          class="inbox"
        >
          <:title>
            Inbox <span :if={@attention > 0} class="badge">{@attention}</span>
          </:title>
          <:subtitle :if={is_nil(@current_workspace)}>
            Replies, mentions, failed turns and sharing changes across all your projects.
          </:subtitle>
          <:subtitle :if={@current_workspace}>
            Replies, mentions, failed turns and sharing changes in {@current_workspace.workspace.name}.
          </:subtitle>
          <:subtitle :if={@other_attention > 0}>
            <span id="inbox-elsewhere" class="hint">
              {@other_attention} in other workspaces. Switch workspace to see them.
            </span>
          </:subtitle>
          <%!-- Nothing is known about the inbox until the rail has been read:
            skeleton cards, never "all caught up" before it has (RAV-67). Two
            of them, the shape of a real card, rather than a guess at a count
            (RAV-100). --%>
          <div
            :if={!@rail_loaded && !@rail_error}
            id="inbox-loading"
            class="inbox-list"
            role="status"
          >
            <span class="sr-only">Loading your inbox…</span>
            <div :for={_ <- 1..2} class="inbox-item inbox-item-skeleton" aria-hidden="true">
              <div class="row">
                <span class="skeleton skeleton-chip"></span>
                <span class="skeleton skeleton-project"></span>
                <span class="spacer"></span>
                <span class="skeleton skeleton-age"></span>
              </div>
              <span class="skeleton skeleton-title"></span>
              <span class="skeleton skeleton-line"></span>
            </div>
          </div>
          <div :if={@rail_error} id="inbox-error" role="alert" class="inbox-empty">
            <p>The inbox could not be loaded.</p>
            <button type="button" phx-click="refresh">Retry</button>
          </div>
          <div :if={@rail_loaded && @attention == 0} class="inbox-empty">
            <h2>You're all caught up</h2>
            <p>When a track needs your attention, it will appear here.</p>
          </div>
          <div class="inbox-list">
            <div
              :for={notice <- @access_notices}
              id={"access-notice-#{notice.id}"}
              class="inbox-item"
            >
              <div class="row">
                <span class="chip">Access removed</span>
                <span class="spacer"></span><.local_time
                  id={"access-notice-#{notice.id}-at"}
                  at={notice.at}
                  zone={@timezone}
                />
              </div>
              <strong>{notice.track_title}</strong>
              <span :if={notice.revoked != []} class="dim">
                Tracks are now shared with workspace members, so {Enum.map_join(
                  notice.revoked,
                  ", ",
                  &"@#{&1}"
                )} can no longer open this track: they are not in its workspace.
              </span>
              <span :if={notice.withdrawn != []} class="dim">
                Invitations withdrawn: {Enum.map_join(notice.withdrawn, ", ", &"@#{&1}")}.
              </span>
              <div class="row">
                <.link patch={"/w/#{notice.workspace_id}/settings/members"}>Invite them to the workspace</.link>
                <.link patch={"/p/#{notice.project_id}/t/#{notice.track_id}"}>Open track</.link>
                <span class="spacer"></span>
                <button
                  type="button"
                  class="ghost"
                  phx-click="dismiss-access-notice"
                  phx-value-id={notice.id}
                >
                  Dismiss
                </button>
              </div>
            </div>
            <div :for={project <- @projects}>
              <.link
                :for={track <- Enum.filter(@tracks[project.id] || [], &attention?/1)}
                patch={inbox_path(project, track)}
                class="inbox-item"
              >
                <div class="row">
                  <span class="chip">
                    {cond do
                      billing_attention?(track) -> "Reconnect"
                      track.status == :setup_failed -> "Setup failed"
                      track.status == :failed -> "Failed turn"
                      track.mention -> "Mentioned"
                      true -> "Unread reply"
                    end}
                  </span>
                  <span class="dim"><.project_name
                    project={project}
                    within={within(@current_workspace)}
                  /></span><span class="spacer"></span><.inbox_age
                    id={"inbox-age-#{track.id}"}
                    at={inbox_time(track)}
                    zone={@timezone}
                  />
                </div>
                <strong title={Track.tooltip(track)}>{Track.label(track)}</strong>
                <span :if={track.visibility == :private}><.icon name="lock" /> Private</span>
                <span class="dim">
                  <%= cond do %>
                    <% billing_attention?(track) -> %>
                      {track.billing_pause.message} Reconnect it, or open the track to try again.
                    <% track.status == :setup_failed -> %>
                      Setup failed. {track.setup_error} Open the track to Retry setup.
                    <% track.status == :failed -> %>
                      The agent needs a hand. Open the conversation to see what happened.
                    <% track.mention -> %>
                      @{track.mention.author_login} mentioned you in a comment.
                    <% track.reply -> %>
                      <span class="inbox-excerpt" id={"inbox-excerpt-#{track.id}"}>{track.reply.excerpt}</span>
                    <% true -> %>
                      The agent finished. Open the conversation to read its reply.
                  <% end %>
                </span>
              </.link>
            </div>
          </div>
        </.stage_page>
      </div>
    </main>
    <.dialog
      :if={@dialog == :sections}
      id="sections-dialog"
      title="Project sections"
      on_close={dismiss(@project, @track_id, @settings)}
    >
      <p class="hint">Group your projects on Home. Sections are visible only to you.</p>
      <%!-- A created section empties the field and keeps the focus there,
        ready for the next name (RAV-130, `SectionForm`); a refused one
        keeps the name beside what was wrong with it. Browsers offer their
        own history over a field like this, so that is turned off. --%>
      <form id="new-section-form" phx-submit="create-section" phx-hook="SectionForm">
        <.input
          field={@section_form[:name]}
          id="section-name"
          label="New section"
          autocomplete="off"
          required
          maxlength="80"
        />
        <button class="primary" phx-disable-with="Creating…">Create section</button>
      </form>
      <div
        :for={section <- @sections}
        id={"section-editor-#{section.id}"}
        class={["section-editor", section.id == @created_section && "created"]}
      >
        <form id={"rename-section-#{section.id}"} phx-submit="rename-section">
          <input type="hidden" name="section_id" value={section.id} />
          <.input
            field={rename_form(section, @rename_forms)[:name]}
            id={"section-name-#{section.id}"}
            label="Section name"
            autocomplete="off"
            required
            maxlength="80"
          />
          <button class="secondary" phx-disable-with="Saving…">Rename</button>
          <button type="button" class="ghost" phx-click="delete-section" phx-value-id={section.id}>Remove section</button>
        </form>
      </div>
      <p :if={@sections != []} class="hint">
        Removing a section keeps its projects in Other projects.
      </p>
      <%!-- Where a project is filed. --%>
      <div :if={@sections != [] && @projects != []} class="section-editor">
        <h3>Move projects</h3>
        <form
          :for={project <- @projects}
          id={"move-project-#{project.id}"}
          phx-change="move-project"
          class="project-section-picker"
        >
          <input type="hidden" name="project" value={project.id} />
          <label for={"project-section-#{project.id}"} class="truncate">
            {label(project, @current_workspace)}
          </label>
          <select
            id={"project-section-#{project.id}"}
            name="section"
            aria-label={"Section for #{label(project, @current_workspace)}"}
          >
            <option value="" selected={is_nil(@section_placements[project.id])}>
              Other projects
            </option>
            <option
              :for={section <- @sections}
              value={section.id}
              selected={@section_placements[project.id] == section.id}
            >
              {section.name}
            </option>
          </select>
        </form>
      </div>
    </.dialog>
    <.dialog
      :if={@dialog == :search}
      id="search-dialog"
      title="Search"
      on_close="dismiss-switcher"
      focus_on_mount={false}
    >
      <form id="search-form" phx-change="search" phx-submit="search">
        <%!-- Every keystroke re-renders the list below it, which is every
          track of every project this person has. A pause is what somebody
          typing a track name actually wants filtered. --%>
        <.input
          name="q"
          id="search-query"
          value={@query}
          label="Search projects, tracks and plans"
          autocomplete="off"
          phx-debounce="150"
          phx-hook="QuickJumpQuery"
        />
      </form>
      <p :if={!@rail_loaded && !@rail_error} role="status">Loading projects…</p>
      <div :if={@rail_error} role="alert">
        <p>Projects could not be loaded.</p><button type="button" phx-click="refresh">Retry</button>
      </div>
      <.track_search_results
        :if={@rail_loaded}
        projects={@projects}
        tracks={@tracks}
        plans={@search_plans}
        query={@query}
        user={@current_user}
        within={within(@current_workspace)}
      />
    </.dialog>
    <.dialog
      :if={@dialog == :new_project}
      id="new-project-dialog"
      title={if @project_mode == "scratch", do: "New scratch project", else: "Add a repository"}
      focus_on_mount={false}
      on_close={dismiss(@project, @track_id, @settings)}
    >
      <%!-- RAV-37: connecting a repository is its own flow; daily work
        starts from New track, or a new thread on a track. --%>
      <p :if={@project_mode != "scratch"} class="lede">
        Connect a repository as a project. Start work in it from New track.
      </p>
      <p :if={@project_mode == "scratch"} class="lede">
        A machine with nothing cloned yet. Start work in it from New track.
      </p>
      <RavixWeb.Live.NewProject.render_form
        form_id="new-project-form"
        autofocus={true}
        project_form={@project_form}
        project_agents={@project_agents}
        project_generation={@project_generation}
        project_agent_error={@project_agent_error}
        project_mode={@project_mode}
        current_user={@current_user}
        session_hash={@session_hash}
        repos={@repos}
        repos_loading={@repos_loading}
        installations={@installations}
        installation={@installation}
        busy={@busy}
      />
    </.dialog>
    <%!-- RAV-60: the prompt leads and has focus; the destination, sharing
      and agent are chips whose menus are popovers, and the footer with
      Create never scrolls away. The chips' radios belong to the form by
      `form=`, since the repository's own forms cannot nest inside it. --%>
    <.dialog
      :if={@dialog == :new_track && @track_project}
      id="new-track-dialog"
      title="New track"
      on_close={dismiss(@project, @track_id, @settings)}
      focus_on_mount={false}
    >
      <div class="new-track-chips">
        <RavixWeb.Live.ModelMenu.chip
          id="new-track-repo"
          label={track_destination(@track_project, @current_workspace)}
          haspopup="dialog"
          class="pick-chip"
          menu_class="chip-popover-below repo-popover"
          menu_label="Repository"
          disabled={@busy}
        >
          <:trigger>
            <.icon name={if @track_project.repo, do: "folder", else: "machine"} size={13} />
            {track_destination(@track_project, @current_workspace)}
          </:trigger>
          <RavixWeb.Live.RepoPicker.picker
            :if={@picker}
            picker={@picker}
            selected={@track_project}
            busy={@busy}
          />
          <form :if={!@picker} id="new-track-project-form" phx-change="new-track-project">
            <label for="new-track-project">Project / repository</label>
            <select id="new-track-project" name="project" disabled={@busy} data-chip-focus>
              <option
                :for={project <- @projects}
                :if={project.access != :tracks}
                value={project.id}
                selected={project.id == @track_project.id}
              >
                {label(project, @current_workspace)}{if project.repo, do: " · #{project.repo}"}
              </option>
            </select>
          </form>
          <%!-- RAV-37: adding a repository from here comes back to this
            dialog with it chosen. The workspace picker has its own. --%>
          <button
            :if={!@picker}
            type="button"
            id="new-track-add-repository"
            class="repo-option ghost"
            phx-click="new-track-add-repository"
            disabled={@busy}
          >
            <.icon name="plus" size={13} />Add a repository…
          </button>
        </RavixWeb.Live.ModelMenu.chip>
        <span class="spacer"></span>
        <RavixWeb.Live.ModelMenu.chip
          :if={private_tracks?(@current_user)}
          id="new-track-sharing"
          label={"Sharing: " <> sharing_label(@track_form.params["visibility"])}
          haspopup="dialog"
          class="pick-chip"
          menu_class="chip-popover-below chip-popover-end"
          menu_label="Sharing"
          disabled={@busy}
        >
          <:trigger>
            <.icon
              name={if @track_form.params["visibility"] == "private", do: "lock", else: "globe"}
              size={13}
            />{sharing_label(@track_form.params["visibility"])}
          </:trigger>
          <fieldset class="chip-group">
            <legend>Who can see this track</legend>
            <label
              :for={{value, title, detail} <- sharing_choices()}
              class="account-item model-option"
            >
              <input
                type="radio"
                class="sr-only"
                name="new_track[visibility]"
                value={value}
                form="new-track-form"
                checked={(@track_form.params["visibility"] || "project") == value}
                data-chip-close
              />
              <span class="chip-choice"><span>{title}</span><small>{detail}</small></span>
              <span class="spacer"></span>
              <span
                :if={(@track_form.params["visibility"] || "project") == value}
                class="check"
                aria-hidden="true"
              >✓</span>
            </label>
          </fieldset>
        </RavixWeb.Live.ModelMenu.chip>
        <span :if={!private_tracks?(@current_user)} class="pick-chip pick-chip-static">
          <.icon name="globe" size={13} />Everyone
          <input type="hidden" name="new_track[visibility]" value="project" form="new-track-form" />
        </span>
      </div>
      <.form
        :let={f}
        for={@track_form}
        id="new-track-form"
        phx-submit="create-track"
        phx-change="edit"
        phx-hook="ProjectFormFocus"
        data-focus="#new-track-prompt"
      >
        <.input
          field={f[:prompt]}
          id="new-track-prompt"
          type="textarea"
          class="new-track-prompt"
          rows="5"
          maxlength="100000"
          phx-hook="SubmitOnEnter"
          phx-debounce="300"
          placeholder="What do you want to work on?"
          aria-label="What do you want to work on?"
          aria-describedby="new-track-prompt-hint"
          disabled={@busy}
        />
        <p id="new-track-prompt-hint" class="sr-only">
          Sent to the agent once setup is ready. Enter creates the track; Shift+Enter adds a line.
        </p>
        <p id="new-track-explainer" class="hint new-track-explainer">
          A track is a branch with its own machine; threads are conversations in it.
        </p>
        <div id="track-advanced" class="track-advanced" hidden={!@advanced_track}>
          <div class="workspace-actions origin-options">
            <button
              :for={{kind, label} <- origin_choices()}
              :if={kind == :blank || @track_project.repo}
              type="button"
              class={if @origin_kind == kind, do: "primary", else: "ghost"}
              phx-click="origin"
              phx-value-kind={kind}
            >
              {label}
            </button>
          </div>
          <.loading_status :if={@refs_loading}>
            Loading {%{branch: "branches", pr: "pull requests", issue: "issues"}[@origin_kind]}…
          </.loading_status>
          <.input
            :if={@origin_kind != :blank}
            field={f[:ref]}
            id="track-ref"
            disabled={@refs_loading}
            label="Start from"
            type="select"
            options={Enum.map(@refs, &{ref_label(&1), ref_id(&1)})}
            required
          />
          <p :if={@reopen && @origin_kind == :branch} id="reopen-hint" class="hint">
            Reopening {@reopen.title}: a new track starts from its branch {@reopen.branch}.
            <span :if={
              !@refs_loading && @refs != [] && !Enum.any?(@refs, &(&1.name == @reopen.branch))
            }>
              That branch isn't on GitHub, so push it first or choose another branch.
            </span>
          </p>
          <p :if={@origin_kind == :blank} class="hint">
            Start from {@track_project.default_branch || "the default branch"}.
          </p>
          <div :if={@origin_kind != :pr}>
            <label for="track-title">Branch name</label>
            <div class="track-branch-input">
              <span id="branch-prefix">ravix/</span>
              <.input
                field={f[:title]}
                id="track-title"
                aria-describedby="branch-prefix branch-hint"
              />
            </div>
            <p id="branch-hint" class="hint">
              {if @origin_kind == :issue,
                do: "Leave empty to use the issue’s number and title.",
                else: "Leave empty for an automatic name (for example, ravix/crewe)."}
            </p>
          </div>
          <p :if={@origin_kind == :pr} class="hint">
            The track uses the pull request's existing branch and name.
          </p>
          <p
            :for={{message, _opts} <- f[:title].errors}
            :if={@origin_kind == :pr}
            class="error fine"
          >
            {message}
          </p>
        </div>
        <.loading_status :if={@busy}>Opening track and preparing its worktree…</.loading_status>
      </.form>
      <RavixWeb.Live.ThreadConnect.panel
        options={@track_options}
        connection={@thread_connect}
        current_user={@current_user}
        session_hash={@session_hash}
      />
      <:footer>
        <RavixWeb.Live.RuntimePicker.menu
          :if={@track_options}
          id="new-track-model"
          options={@track_options}
          params={@track_form.params}
          name="new_track"
          form="new-track-form"
          disabled={@busy}
        />
        <span :if={!@track_options} class="pick-chip pick-chip-static dim">Loading agents…</span>
        <button
          type="button"
          id="new-track-options"
          class="ghost chip-options"
          phx-click="advanced-track"
          aria-expanded={to_string(@advanced_track)}
          aria-controls="track-advanced"
          title={
            if @advanced_track,
              do: "Hide options",
              else:
                "New worktree from #{@track_project.default_branch || "the default branch"}, with an automatic name"
          }
        >
          <.icon name="more" size={14} /><span>Options</span>
        </button>
        <span class="spacer"></span>
        <button
          type="submit"
          form="new-track-form"
          id="new-track-create"
          class="primary"
          aria-label="Create track"
          aria-keyshortcuts="Enter"
          disabled={
            @busy || (@origin_kind != :blank && @refs == []) || creator_blocked?(@track_options)
          }
          phx-disable-with="Opening…"
        >
          {if @busy, do: "Opening track…", else: "Create"}<kbd :if={!@busy} aria-hidden="true">↵</kbd>
        </button>
      </:footer>
    </.dialog>
    <.dialog
      :if={@dialog == :changes}
      id="changes-dialog"
      title="What's new"
      on_close={dismiss(@project, @track_id, @settings)}
    >
      <p class="lede">Changes in Ravix since you last checked.</p>
      <button type="button" class="secondary" phx-click="mark-changes-seen">Mark all as read</button>
      <div class="changes-list">
        <article :for={entry <- @changes} class="change-entry">
          <small>{entry.date} · {entry.kind}</small><h3>{entry.title}</h3>
          <p>{Phoenix.HTML.raw(RavixWeb.Markdown.render_safe(entry.body))}</p>
        </article>
      </div>
    </.dialog>
    <.dialog
      :if={@dialog == :help}
      id="help-dialog"
      title="Help – AI tools"
      on_close={dismiss(@project, @track_id, @settings)}
    >
      <button type="button" class="secondary" phx-click="dialog" phx-value-name="changes">What's new<span
        :if={@changes_unseen > 0}
        class="chip"
      >{@changes_unseen}</span></button>
      <RavixWeb.HelpComponents.agent_tooling />
    </.dialog>
    <.dialog
      :if={@dialog == :account}
      id="account-dialog"
      title="Your account"
      on_close={dismiss(@project, @track_id, @settings)}
    >
      <p class="lede">
        Signed in as <strong>@{@current_user.login}</strong>. Connect either or both agents and choose a default for new projects. Each project uses its selected agent, paid for by its owner’s subscription or API key, whoever is working.
      </p>
      <.live_component
        module={RavixWeb.Live.AgentPanel}
        id="agent-panel"
        initial_agent={@reconnect_agent}
        current_user={@current_user}
        session_hash={@session_hash}
      />
      <hr />
      <p class="account-connections">
        <.link patch="/settings/connected-apps">Manage connected applications →</.link>
        <span class="hint">Review access granted to external tools and disconnect them.</span>
      </p>
      <p class="hint">
        <a href="/api/auth/install">Change which GitHub repositories Ravix may work in ↗</a>
      </p>
    </.dialog>
    <RavixWeb.Live.WorkspaceSwitcher.new_workspace_dialog
      :if={@dialog == :new_workspace}
      on_close={dismiss(@project, @track_id, @settings)}
    />
    <.live_component
      :if={@dialog == :people && @project}
      module={RavixWeb.Live.PeopleDialog}
      id="people"
      scope={:project}
      project={@project}
      subject_id={@project.id}
      current_user={@current_user}
      session_hash={@session_hash}
    />
  </div>
</Layouts.app>
