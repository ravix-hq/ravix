<Layouts.app flash={@flash}>
  <div :if={is_nil(@current_user)} class="landing">
    <header class="landing-nav">
      <a href="/" aria-label="Ravix home"><.wordmark unit={4} /></a>
      <nav aria-label="Main navigation">
        <a href="#how-it-works">How it works</a><a class="landing-button" href="/auth/github">Sign in ↗</a>
      </nav>
    </header>
    <main>
      <section class="landing-hero" aria-labelledby="landing-title">
        <div>
          <p class="landing-eyebrow">Your repo. A cloud machine. The laptop can close.</p>
          <h1 id="landing-title">One project.<br />Many tracks.</h1>
          <p class="landing-intro">
            Ravix is a browser workspace for building software with coding agents. Give a feature, a bug fix and your next idea their own branches on one persistent cloud machine, and the work keeps going after you close the lid.
          </p>
          <div class="landing-actions">
            <a class="landing-button landing-primary" href="/auth/github">Get started →</a><a href="#how-it-works">See how it works ↓</a>
          </div>
          <p class="landing-note">
            Sign in with GitHub. No local setup, no API key to bring. Inference is included.
          </p>
        </div>
        <div class="landing-example" aria-label="Example project with three separate tracks">
          <div class="landing-example-head">
            <strong>your-project</strong><span>cloud workspace</span>
          </div>
          <div class="landing-tracks">
            <div
              :for={
                {title, branch, status} <- [
                  {"Build the next feature", "feature/dashboard", "Working"},
                  {"Fix a stubborn bug", "fix/sign-in", "Queued"},
                  {"Try something new", "explore/new-idea", "Ready to review"}
                ]
              }
              class="landing-track"
            >
              <div><strong>{title}</strong><code>{branch}</code></div>
              <span class="landing-tag">{status}</span>
            </div>
          </div>
          <div class="landing-example-foot">
            <span>Each track has its own</span><strong>Branch · Files · Agent conversation</strong>
          </div>
        </div>
      </section>
      <section class="landing-workflow" id="how-it-works">
        <h2>Less setup. More making.</h2>
        <div class="landing-steps">
          <article>
            <span>01 / CONNECT</span>
            <h3>Bring your repository</h3>
            <p>
              Sign in with GitHub and choose a repository. Ravix prepares a cloud machine with your code already cloned.
            </p>
          </article>
          <article>
            <span>02 / BUILD</span>
            <h3>Give each task a track</h3>
            <p>
              Each track gets its own branch, working files and conversation, so separate tasks stay separate.
            </p>
          </article>
          <article>
            <span>03 / REVIEW</span>
            <h3>See what changed</h3>
            <p>
              Read the diff, check the files, and ask for a live preview. Open a pull request when you’re ready.
            </p>
          </article>
        </div>
      </section>
    </main>
  </div>
  <div :if={@current_user} class="app">
    <aside class="yard" aria-label="Projects and tracks">
      <div class="yard-head">
        <.link patch="/home" aria-label="Ravix home"><.wordmark unit={3} /></.link>
      </div>
      <div class="workspace-actions">
        <.link patch="/inbox" class="ghost">Inbox</.link>
        <button class="ghost" phx-click="dialog" phx-value-name="search">Search</button>
        <button class="primary" phx-click="dialog" phx-value-name="new-project">
          New project
        </button>
      </div>
      <div class="yard-scroll">
        <section :for={project <- @projects} class="workspace-project">
          <.link
            patch={"/p/#{project.id}"}
            class={["workspace-project-name", @project && @project.id == project.id && "selected"]}
          >
            {project.name}
          </.link>
          <.link
            :for={track <- @tracks[project.id] || []}
            patch={"/p/#{project.id}/t/#{track.id}"}
            class={["workspace-track", @track_id == track.id && "selected"]}
          >
            <span class={"status-dot #{track.status}"}></span><span>{track.title}</span><span
              :if={track.unread}
              aria-label="Unread"
            >●</span>
          </.link>
        </section>
      </div>
      <div class="workspace-account">
        <span>@{@current_user.login}</span>
        <.link href="/auth/signout" method="post" class="ghost">Sign out</.link>
        <div id="theme-picker" phx-hook="Theme" class="theme-picker">
          <button class="theme-trigger" data-theme-toggle aria-haspopup="menu">
            <span class="theme-swatch" data-theme-swatch></span><span data-theme-name>Theme</span>
          </button>
          <div class="theme-menu" role="menu" hidden>
            <button
              :for={
                theme <-
                  ~w(ravix slate one-dark dracula nord tokyo-night catppuccin-mocha night-owl monokai gruvbox-dark solarized-dark daylight github-light one-light solarized-light catppuccin-latte mario neon-noir vaporwave matrix hot-dog-stand bubblegum)
              }
              class="theme-option"
              role="menuitemradio"
              data-theme-choice={theme}
            >
              <span class="theme-swatch" data-theme={theme}></span><span>{theme}</span><span
                data-theme-check
                hidden
              >✓</span>
            </button>
          </div>
        </div>
      </div>
    </aside>
    <main class="stage">
      <nav class="workspace-mobile-nav" aria-label="Workspace navigation">
        <.link patch="/home">Projects</.link><.link patch="/inbox">Inbox</.link><button
          class="ghost"
          phx-click="dialog"
          phx-value-name="search"
        >Tracks</button><button class="ghost" phx-click="dialog" phx-value-name="new-project">New project</button>
      </nav>
      <div
        id="yard-resize"
        phx-hook="PanelResize"
        class="panel-resize-handle left"
        role="separator"
        tabindex="0"
        aria-label="Sidebar width"
        aria-orientation="vertical"
        data-var="--yard-width"
        data-min="220"
        data-max="480"
        data-key="ravix.panel-width.left"
        data-side="left"
      >
      </div>
      <div :if={@project} class="crumbs">
        <strong>{@project.name}</strong><span class="chip mono">{@project.repo}</span><span class="spacer"></span>
        <button
          :if={@project.access != :tracks}
          class="ghost"
          phx-click="dialog"
          phx-value-name="new-track"
        >
          New track
        </button>
        <button
          :if={@project.access != :tracks}
          class="ghost"
          phx-click="dialog"
          phx-value-name="people"
        >
          People
        </button>
        <button
          :if={@project.role == :owner}
          class="ghost"
          phx-click="dialog"
          phx-value-name="settings"
        >
          Settings
        </button>
      </div>
      <div :if={@project && @track_id} class="workspace-track-host">
        {live_render(@socket, RavixWeb.TrackLive,
          id: "track-#{@track_id}",
          session: %{
            "session_token" => @session_token,
            "track_id" => @track_id,
            "project_id" => @project.id
          }
        )}
      </div>
      <div :if={@project && is_nil(@track_id)} class="workspace-welcome">
        <h1>{@project.name}</h1>
        <p>Each track is its own worktree, branch, and agent conversation.</p>
        <button
          :if={@project.access != :tracks}
          class="primary"
          phx-click="dialog"
          phx-value-name="new-track"
        >
          New track
        </button>
        <p :if={@project.access == :tracks}>Choose a track shared with you in the sidebar.</p>
      </div>
      <div :if={is_nil(@project)} class="workspace-welcome">
        <h1>{if @live_action in [:home, :inbox], do: "Inbox", else: "Your projects"}</h1>
        <p>Pick up where you left off, or start a new project.</p>
        <button class="ghost" phx-click="refresh">Refresh</button>
        <div class="workspace-cards">
          <.link :for={project <- @projects} patch={"/p/#{project.id}"} class="workspace-card">
            <strong>{project.name}</strong><span>{project.repo || "Scratch workspace"}</span>
          </.link>
        </div>
        <h2>Needs your attention</h2>
        <div :for={project <- @projects}>
          <.link
            :for={track <- Enum.filter(@tracks[project.id] || [], &attention?/1)}
            patch={"/p/#{project.id}/t/#{track.id}"}
            class="workspace-track"
          >
            {project.name} / {track.title} <span class="chip">{track.status}</span>
          </.link>
        </div>
        <button class="primary" phx-click="dialog" phx-value-name="new-project">
          New project
        </button>
      </div>
    </main>
    <.dialog :if={@dialog == "search"} id="search-dialog" title="Find a track" on_close="dismiss">
      <form phx-change="search">
        <.input
          name="q"
          id="search-query"
          value={@query}
          label="Search projects and tracks"
          autofocus
        />
      </form>
      <div :for={project <- @projects}>
        <.link
          :for={track <- Enum.filter(@tracks[project.id] || [], &matching?(&1, project, @query))}
          patch={"/p/#{project.id}/t/#{track.id}"}
          class="workspace-track"
        >
          {project.name} / {track.title}
        </.link>
      </div>
    </.dialog>
    <.dialog
      :if={@dialog == "new-project"}
      id="new-project-dialog"
      title="New project"
      on_close="dismiss"
    >
      <form :if={@installations != []} phx-change="installation">
        <.input
          name="installation"
          id="installation"
          label="GitHub account"
          type="select"
          value={@installation}
          options={Enum.map(@installations, &{&1.account, &1.id})}
        />
      </form>
      <form id="new-project-form" phx-submit="create-project" phx-change="edit">
        <.input
          name="name"
          id="project-name"
          label="Project name"
          value={@form_data["name"] || ""}
          maxlength="120"
        />
        <.input
          name="repo"
          id="project-repo"
          label="Repository"
          type="select"
          value={@form_data["repo"] || ""}
          options={[
            {"No repository (scratch)", ""} | Enum.map(@repos, &{&1.full_name, &1.full_name})
          ]}
        />
        <p><a href="/api/auth/install">Connect or manage GitHub repositories ↗</a></p>
        <button class="primary" disabled={@busy} phx-disable-with="Creating…">
          Create project
        </button>
      </form>
    </.dialog>
    <.dialog
      :if={@dialog == "new-track" && @project}
      id="new-track-dialog"
      title="New track"
      on_close="dismiss"
    >
      <div class="workspace-actions">
        <button
          :for={
            {kind, label} <- [
              {"blank", "Blank"},
              {"branch", "Branch"},
              {"pr", "Pull request"},
              {"issue", "Issue"}
            ]
          }
          :if={kind == "blank" || @project.repo}
          class={if @origin_kind == kind, do: "primary", else: "ghost"}
          phx-click="origin"
          phx-value-kind={kind}
        >
          {label}
        </button>
      </div>
      <form id="new-track-form" phx-submit="create-track" phx-change="edit">
        <.input
          name="title"
          id="track-title"
          label="Track title"
          value={@form_data["title"] || ""}
          maxlength="200"
        />
        <.input
          :if={@origin_kind != "blank"}
          name="ref"
          id="track-ref"
          label="Start from"
          type="select"
          value={@form_data["ref"] || ""}
          options={Enum.map(@refs, &{ref_label(&1), ref_id(&1)})}
          required
        />
        <button
          class="primary"
          disabled={@busy || (@origin_kind != "blank" && @refs == [])}
          phx-disable-with="Opening…"
        >
          Open track
        </button>
      </form>
    </.dialog>
    <.dialog
      :if={@dialog == "settings" && @settings}
      id="settings-dialog"
      title="Project settings"
      on_close="dismiss"
      wide
    >
      <form id="settings-form" phx-submit="save-settings">
        <.input name="name" id="settings-name" label="Name" value={@settings.name} required />
        <.input
          name="runtime"
          id="settings-runtime"
          label="Harness"
          value={@settings.runtime}
          list="runtime-options"
        />
        <datalist id="runtime-options">
          <option :for={runtime <- (@settings.catalog || %{})["runtimes"] || []} value={runtime} />
        </datalist>
        <.input name="model" id="settings-model" label="Model" value={@settings.model} />
        <.input
          type="textarea"
          name="instructions"
          id="settings-instructions"
          label="Instructions"
          value={@settings.instructions}
          rows="5"
        />
        <.input
          type="textarea"
          name="setup_script"
          id="settings-setup"
          label="Setup script"
          value={@settings.setup_script}
          rows="5"
        />
        <.input
          :for={kind <- ~w(apt pip npm)}
          name={kind}
          id={"packages-#{kind}"}
          label={"#{kind} packages"}
          value={Enum.join(@settings.packages[kind] || [], " ")}
        />
        <button class="primary" phx-disable-with="Saving…">Save settings</button>
      </form>
      <hr />
      <h3>Secrets</h3>
      <p>Values are write-only. Submit an empty value to remove a secret.</p>
      <p>Environment: {Enum.join(@settings.env_keys, ", ")}</p>
      <p>Vault: {Enum.join(@settings.vault_keys, ", ")}</p>
      <form id="secret-form" phx-submit="save-secret">
        <.input
          name="store"
          id="secret-store"
          label="Store"
          type="select"
          value="env"
          options={[{"Environment", "env"}, {"Vault", "vault"}]}
        />
        <.input name="key" id="secret-key" label="Key" value="" required />
        <.input
          name="value"
          id="secret-value"
          type="password"
          label="Value"
          value=""
          autocomplete="new-password"
        />
        <button class="primary" phx-disable-with="Saving…">Update secret</button>
      </form>
      <hr />
      <h3>Preview defaults</h3>
      <form id="preview-defaults-form" phx-submit="save-preview-defaults">
        <.input
          name="directory"
          id="default-directory"
          label="App directory"
          value={(@preview_defaults || %{})[:directory] || "."}
        />
        <.input
          name="command"
          id="default-command"
          label="Command (must honor $PORT)"
          value={(@preview_defaults || %{})[:command] || ""}
        />
        <.input
          name="readiness_path"
          id="default-readiness"
          label="Readiness path"
          value={(@preview_defaults || %{})[:readiness_path] || "/"}
        />
        <button class="primary">Save defaults</button><button
          name="clear"
          value="true"
          class="ghost"
        >Clear defaults</button>
      </form>
      <hr />
      <h3>Machine and project</h3>
      <p>
        Rebuilding discards the machine and closes every track. Deleting also removes the project settings and secrets.
      </p>
      <form id="project-danger-form" phx-submit="project-danger">
        <.input
          name="confirm"
          id="danger-confirm"
          label={"Type #{@project.name} to confirm"}
          value=""
          required
        />
        <button name="action" value="rebuild" class="ghost" disabled={@busy}>
          Rebuild machine
        </button>
        <button name="action" value="delete" class="danger" disabled={@busy}>
          Delete project
        </button>
      </form>
    </.dialog>
    <.dialog
      :if={@dialog == "people" && @project}
      id="people-dialog"
      title="Project people"
      on_close="dismiss"
    >
      <p>Project members can open tracks and work in every track on this machine.</p>
      <div :for={person <- @people} class="workspace-track">
        <span>@{person.login}</span><button
          :if={@project.role == :owner || person.login == @current_user.login}
          class="ghost"
          phx-click="remove-person"
          phx-value-login={person.login}
        >{if person.login == @current_user.login, do: "Leave project", else: "Remove"}</button>
      </div>
      <form :if={@project.role == :owner} id="invite-form" phx-submit="invite-person">
        <.input name="login" id="invite-login" label="GitHub username" value="" required />
        <button class="primary">
          Invite
        </button>
      </form>
      <div :if={@project.role == :owner}>
        <button class="ghost" phx-click="invite-link" phx-value-action="create">
          Create invite link
        </button>
        <button class="ghost" phx-click="invite-link" phx-value-action="revoke">
          Revoke invite link
        </button>
      </div>
      <p :if={invitation_url(@invite)}>
        <a href={invitation_url(@invite)}>{invitation_url(@invite)}</a>
      </p>
    </.dialog>
  </div>
</Layouts.app>
