<Layouts.app flash={@flash}>
  <main :if={is_nil(@current_user)} class="centred signin-page">
    <div class="corner-theme"><.theme_picker id="signin-theme" /></div>
    <div class="signin-card">
      <div class="signin-mark"><.wordmark size={32} /></div>
      <h1>Sign in to Ravix</h1>
      <p class="lede">Share the running version, and keep working on it together.</p>
      <ul class="points">
        <li>
          <.icon name="globe" size={14} class="ico" />
          <span>
            <strong>A live preview</strong>
            <small>The app is already running when someone opens it.</small>
          </span>
        </li>
        <li>
          <.icon name="add-person" size={14} class="ico" />
          <span>
            <strong>One conversation</strong>
            <small>The next change stays in the same thread.</small>
          </span>
        </li>
        <li>
          <.icon name="machine" size={14} class="ico" />
          <span>
            <strong>A cloud machine</strong>
            <small>The work continues after you close the laptop.</small>
          </span>
        </li>
      </ul>
      <a
        :if={@github_available}
        class="landing-button landing-primary gh-button"
        href="/auth/github"
      >
        <.icon name="github" size={17} />Sign in with GitHub
      </a>
      <p :if={!@github_available} class="error">
        GitHub sign-in is not configured for this deployment. Contact the person who runs it to get access.
      </p>
    </div>
  </main>
  <div :if={@current_user} class="app" id="workspace-navigation" phx-hook="QuickJump">
    <%!-- On a phone the yard is gone and "Menu" in the mobile nav brings it
      back over the page (`forced`); the scrim behind it, a tap on the x,
      Escape, and any navigation close it again. See `yard_open`. --%>
    <div
      :if={@yard_open}
      class="yard-scrim"
      phx-click="yard-close"
      phx-window-keydown="yard-close"
      phx-key="escape"
      aria-hidden="true"
    >
    </div>
    <aside id="yard" class={["yard", @yard_open && "forced"]} aria-label="Projects">
      <%!-- Account preferences live in the sidebar footer; the native popover
        retains light dismiss, Escape and focus return. --%>
      <div class="yard-top">
        <RavixWeb.Live.WorkspaceSwitcher.switcher
          workspaces={@workspaces}
          current_id={@current_workspace && @current_workspace.workspace.id}
        />
        <button
          id="quick-jump-trigger"
          type="button"
          class="ghost"
          title="Search projects, tracks and plans (⌘/Ctrl K)"
          data-quick-jump-trigger
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="search"
        >
          <.icon name="search" /><span class="sr-only">Search</span>
        </button>
        <button
          type="button"
          id="yard-toggle"
          phx-hook="PanelToggle"
          class="ghost panel-toggle"
          data-panel="yard"
          data-key="ravix.panel.yard"
          data-hide-label="Hide projects"
          data-show-label="Show projects"
          aria-controls="yard"
          aria-expanded="true"
          title="Hide projects"
        >
          <.icon name="panel-left" size={16} />
          <span class="sr-only label-hide">Hide projects</span>
          <span class="sr-only label-show">Show projects</span>
        </button>
        <button type="button" class="x yard-close" phx-click="yard-close" aria-label="Close menu">
          <.icon name="x" size={16} />
        </button>
      </div>
      <div id="account-menu" class="account-menu" popover aria-label="You">
        <.theme_picker id="theme-picker" />
        <div id="notify" phx-hook="Notify" class="notify">
          <button
            type="button"
            class="theme-trigger"
            data-notify-toggle
            aria-pressed="false"
            title="Say so from the desktop when a track needs you and this tab is in the background"
          >
            <span class="notify-dot" data-notify-dot></span><span class="col"><small>Desktop notifications</small><span
              class="truncate"
              data-notify-state
            >Off</span></span>
          </button>
        </div>
        <hr />
        <button
          type="button"
          class="account-item"
          id="open-account"
          popovertarget="account-menu"
          popovertargetaction="hide"
          phx-click={JS.push_focus(to: "#account-trigger") |> JS.push("dialog")}
          phx-value-name="account"
        >
          <.icon name="person" size={14} />Account
        </button>
        <button
          type="button"
          class="account-item"
          id="open-personal-settings"
          popovertarget="account-menu"
          popovertargetaction="hide"
          phx-click={JS.patch("/settings/connected-apps")}
        >
          <.icon name="settings" size={14} />Settings
        </button>
        <a class="account-item" href="/api/auth/install">
          <.icon name="github" size={14} />Repository access
        </a>
        <button
          type="button"
          class="account-item"
          id="open-help"
          popovertarget="account-menu"
          popovertargetaction="hide"
          phx-click={JS.push_focus(to: "#account-trigger") |> JS.push("dialog")}
          phx-value-name="help"
        >
          <.icon name="info" size={14} />Help
        </button>
        <button
          type="button"
          class="account-item"
          id="open-changes"
          popovertarget="account-menu"
          popovertargetaction="hide"
          phx-click={JS.push_focus(to: "#account-trigger") |> JS.push("dialog")}
          phx-value-name="changes"
          aria-label="What's new"
        >
          <.icon name="sparkle" size={14} />What's new<span class="spacer"></span><span
            :if={@changes_unseen > 0}
            class="badge"
          >{@changes_unseen}</span>
        </button>
        <hr />
        <.link href="/auth/signout" method="post" class="account-item">
          <.icon name="sign-out" size={14} />Sign out
        </.link>
      </div>
      <div class="workspace-actions yard-nav">
        <button
          id="top-new-track"
          class="primary"
          data-new-track-trigger
          aria-keyshortcuts="Control+N Meta+N"
          phx-click={JS.push_focus() |> JS.push("top-new-track")}
        >
          <.icon name="plus" />New track
        </button>
        <.link patch="/inbox" class={["yard-item", @live_action in [:home, :inbox] && "on"]}>
          <.icon name="terminal" />Inbox<span class="spacer"></span>
          <span :if={@attention > 0} class="badge">{@attention}</span>
        </.link>
        <.link patch="/home" class={["yard-item", @live_action == :projects && "on"]}>
          <.icon name="home" />Home
        </.link>
        <button
          class="yard-item"
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="new-project"
        >
          <.icon name="plus" />Add a project
        </button>

        <.link patch="/schedules" class={["yard-item", @live_action == :schedules && "on"]}>
          <.icon name="clock" />Schedules
        </.link>
      </div>
      <div class="yard-scroll">
        <div class="section-label">
          <strong>Projects</strong><span class="spacer"></span>
          <button
            type="button"
            id="manage-sections"
            class="section-action"
            aria-label="Manage sections"
            title="Organize projects into sections"
            phx-click={JS.push_focus() |> JS.push("dialog")}
            phx-value-name="sections"
          >
            <.icon name="settings" size={13} />
          </button>
        </div>
        <div id="rail-scope" class="rail-scope" role="group" aria-label="Show tracks from">
          <button
            :for={{scope, label} <- [everyone: "Everyone", mine: "Mine"]}
            type="button"
            id={"rail-scope-#{scope}"}
            class={if @current_user.rail_scope == scope, do: "on", else: "ghost"}
            aria-pressed={to_string(@current_user.rail_scope == scope)}
            title={
              if scope == :mine,
                do: "Only tracks you created",
                else: "Every track you can see"
            }
            phx-click="rail-scope"
            phx-value-scope={scope}
          >{label}</button>
        </div>
        <div
          id="project-sections"
          phx-hook="ProjectSections"
          aria-busy={to_string(!@rail_loaded && !@rail_error)}
        >
          <div :if={!@rail_loaded && !@rail_error} id="rail-loading" role="status">
            <span class="sr-only">Loading projects…</span>
            <span :for={_ <- 1..4} class="skeleton rail-row-skeleton" aria-hidden="true"></span>
          </div>
          <div :if={@rail_error} id="rail-error" role="alert">
            <p>Projects could not be loaded.</p><button type="button" phx-click="refresh">Retry</button>
          </div>
          <div id="project-tree" phx-hook="ProjectTree" data-viewer={@current_user.id}>
            <section
              :for={
                {section, projects} <-
                  section_groups(
                    @projects,
                    @sections,
                    @section_placements,
                    @scratch_group,
                    @shared_ids
                  )
              }
              id={"section-#{section_key(section)}"}
              class={["project-section", section_labelled?(section, @sections) && "labelled"]}
              data-section-drop={if !scratch_section?(section), do: section.id || ""}
            >
              <button
                :if={section_labelled?(section, @sections)}
                type="button"
                class="ghost section-toggle"
                data-collapse={if is_nil(section.id), do: "section-#{section_key(section)}"}
                phx-click={if section.id, do: "toggle-section"}
                phx-value-id={section.id}
                phx-value-collapsed={to_string(!section.collapsed)}
                aria-expanded={to_string(!section.collapsed)}
                aria-controls={"section-projects-#{section_key(section)}"}
              >
                <.disclosure_chevron />
                <span class="truncate">{section.name}</span>
              </button>
              <div id={"section-projects-#{section_key(section)}"} hidden={section.collapsed}>
                <p
                  :if={projects == [] and section_labelled?(section, @sections)}
                  id={"section-empty-#{section_key(section)}"}
                  class="section-empty dim"
                >
                  No projects
                </p>
                <section
                  :for={project <- projects}
                  id={"project-row-#{project.id}"}
                  class={["workspace-project", @project && @project.id == project.id && "current"]}
                  draggable={to_string(@sections != [] and !scratch_section?(section))}
                  data-project-id={project.id}
                >
                  <div class="workspace-project-row">
                    <button
                      type="button"
                      class="ghost project-collapse"
                      data-collapse={project.id}
                      aria-label={"Tracks in #{project.display_name}"}
                      aria-expanded="true"
                      aria-controls={"project-tracks-#{project.id}"}
                    >
                      <.disclosure_chevron />
                    </button>
                    <.link
                      id={"project-link-#{project.id}"}
                      patch={"/p/#{project.id}"}
                      class={[
                        "workspace-project-name",
                        @project && @project.id == project.id && "selected"
                      ]}
                      aria-current={
                        if @project && @project.id == project.id && is_nil(@track_id), do: "page"
                      }
                    >
                      <span class="truncate"><.project_name project={project} /></span>
                      <span
                        :if={project_attention(@tracks, project.id) > 0}
                        class="badge"
                        aria-label={"#{project_attention(@tracks, project.id)} unread"}
                      >{project_attention(@tracks, project.id)}</span>
                    </.link>
                    <.link
                      :if={project.access != :tracks}
                      id={"project-plans-#{project.id}"}
                      patch={"/p/#{project.id}/plans"}
                      class={[
                        "project-action",
                        @live_action == :plans && @project && @project.id == project.id && "on"
                      ]}
                      aria-label={"Plans in #{project.display_name}"}
                      aria-current={
                        if @live_action == :plans && @project && @project.id == project.id,
                          do: "page"
                      }
                      title="Plans"
                    >
                      <.icon name="document" size={13} />
                    </.link>
                    <button
                      :if={project.access != :tracks && project.role == :owner}
                      type="button"
                      class="project-action"
                      aria-label={"Project settings for #{project.display_name}"}
                      title="Project settings"
                      phx-click={JS.push_focus() |> JS.push("project-settings")}
                      phx-value-project={project.id}
                    >
                      <.icon name="settings" size={13} />
                    </button>
                    <button
                      :if={project.access != :tracks}
                      type="button"
                      id={"project-menu-trigger-#{project.id}"}
                      class="project-action"
                      aria-label={"More for #{project.display_name}"}
                      title="More"
                      popovertarget={"project-menu-#{project.id}"}
                    >
                      <.icon name="more" size={13} />
                    </button>
                    <div
                      :if={project.access != :tracks}
                      id={"project-menu-#{project.id}"}
                      class="project-menu"
                      popover
                      role="menu"
                      aria-label={"More for #{project.display_name}"}
                    >
                      <%!-- People lives in here rather than on the row: it
                        only ever showed on the open project, so opening a
                        track made that one row an icon wider and cut its
                        name short (RAV-63). --%>
                      <button
                        :if={@project && @project.id == project.id}
                        type="button"
                        class="account-item"
                        role="menuitem"
                        aria-label={"People in #{project.display_name}"}
                        popovertarget={"project-menu-#{project.id}"}
                        popovertargetaction="hide"
                        phx-click={
                          JS.push_focus(to: "#project-menu-trigger-#{project.id}")
                          |> JS.push("dialog")
                        }
                        phx-value-name="people"
                      >
                        <span class="menu-check" aria-hidden="true">
                          <.icon name="add-person" size={14} />
                        </span>People
                      </button>
                      <button
                        type="button"
                        id={"show-closed-#{project.id}"}
                        class="account-item"
                        role="menuitemcheckbox"
                        aria-checked={to_string(MapSet.member?(@closed_projects, project.id))}
                        popovertarget={"project-menu-#{project.id}"}
                        popovertargetaction="hide"
                        phx-click="show-closed"
                        phx-value-project={project.id}
                        phx-value-show={to_string(!MapSet.member?(@closed_projects, project.id))}
                      >
                        <span class="menu-check" aria-hidden="true">
                          <.icon :if={MapSet.member?(@closed_projects, project.id)} name="check" size={14} />
                        </span>Show closed tracks
                      </button>
                    </div>
                    <.link
                      :if={project.access != :tracks}
                      patch={"/p/#{project.id}#{if @project && @project.id == project.id, do: track_suffix(@track_id), else: ""}?new=track"}
                      id={"new-track-#{project.id}"}
                      phx-click={JS.push_focus()}
                      class="project-action project-add"
                      aria-label={"New track in #{project.display_name}"}
                      title="New track"
                    >
                      <.icon name="plus" size={13} />
                    </.link>
                  </div>
                  <nav
                    id={"project-tracks-#{project.id}"}
                    class="project-tree-tracks"
                    aria-label={"Tracks in #{project.display_name}"}
                  >
                    <.link
                      :for={
                        track <- rail_rows(@tracks[project.id] || [], @current_user, @track_id)
                      }
                      id={"project-track-tab-#{track.id}"}
                      patch={"/p/#{project.id}/t/#{track.id}"}
                      class={["workspace-track track-tab", @track_id == track.id && "selected"]}
                      aria-current={if @track_id == track.id, do: "page"}
                      data-label={tab_name(track)}
                      aria-label={row_label(track, tab_name(track))}
                      title={track.title}
                    >
                      <.status_slot track={track} />
                      <.creator track={track} />
                      <span class="track-title">{tab_label(track)}</span>
                      <span :if={track.visibility == :private} class="track-private">
                        <.icon name="lock" /> Private
                      </span>
                      <.age id={"track-age-#{track.id}"} at={track.activity_at} />
                    </.link>
                    <div :if={MapSet.member?(@track_errors, project.id)} role="status">
                      <p class="hint">Couldn't load tracks</p>
                      <button
                        type="button"
                        class="ghost"
                        phx-click="retry-tracks"
                        phx-value-id={project.id}
                        disabled={MapSet.member?(@track_loading, project.id)}
                      >{if MapSet.member?(@track_loading, project.id),
                        do: "Retrying…",
                        else: "Retry"}</button>
                    </div>
                    <p
                      :if={
                        @rail_loaded && !MapSet.member?(@track_errors, project.id) &&
                          rail_rows(@tracks[project.id] || [], @current_user, @track_id) == []
                      }
                      class="hint"
                    >
                      {if (@tracks[project.id] || []) == [],
                        do: "No open tracks",
                        else: "No open tracks of yours"}
                    </p>
                    <div
                      :if={MapSet.member?(@closed_projects, project.id)}
                      id={"closed-tracks-#{project.id}"}
                      class="closed-tracks"
                    >
                      <p class="section-label"><small>Closed</small></p>
                      <ul aria-label={"Closed tracks in #{project.display_name}"}>
                        <li
                          :for={
                            track <-
                              @closed_tracks[project.id]
                              |> Kernel.||([])
                              |> Enum.take(closed_shown_count(@closed_pages, project.id))
                              |> rail_rows(@current_user, nil)
                          }
                          id={"closed-track-#{track.id}"}
                          class="workspace-track closed-track"
                        >
                          <span class="track-status" aria-hidden="true"></span>
                          <.creator track={track} />
                          <span class="track-title truncate" title={track.title}>
                            {tab_label(track)}<span class="sr-only">, closed</span>
                          </span>
                          <span :if={track.visibility == :private} class="track-private">
                            <.icon name="lock" /> Private
                          </span>
                          <.age id={"closed-track-age-#{track.id}"} at={track.activity_at} />
                          <button
                            :if={reopenable?(project)}
                            type="button"
                            id={"reopen-track-#{track.id}"}
                            class="ghost"
                            aria-label={"Reopen #{track.title}"}
                            phx-click={JS.push_focus() |> JS.push("reopen-track")}
                            phx-value-track={track.id}
                          >Reopen</button>
                        </li>
                      </ul>
                      <p
                        :if={
                          rail_rows(@closed_tracks[project.id] || [], @current_user, nil) == []
                        }
                        class="hint"
                      >
                        No closed tracks
                      </p>
                      <button
                        :if={
                          length(@closed_tracks[project.id] || []) >
                            closed_shown_count(@closed_pages, project.id)
                        }
                        type="button"
                        id={"closed-older-#{project.id}"}
                        class="ghost"
                        phx-click="closed-older"
                        phx-value-project={project.id}
                      >
                        Show older
                      </button>
                    </div>
                  </nav>
                </section>
              </div>
            </section>
          </div>
        </div>
      </div>
      <div class="yard-footer">
        <button
          type="button"
          id="account-trigger"
          class="yard-account"
          aria-label={"You" <> if(@changes_unseen > 0, do: ", #{@changes_unseen} new in What's new", else: "")}
          title="You"
          popovertarget="account-menu"
        >
          <span class="account-icon">
            <.icon name="settings" size={18} />
            <span :if={@changes_unseen > 0} class="account-unseen" id="account-unseen">
              <span class="sr-only">, {@changes_unseen} new in What's new</span>
            </span>
          </span>
          <span class="yard-who">
            <strong class="truncate">You</strong><small class="truncate">@{@current_user.login}</small>
          </span>
          <span class="sr-only">Account menu</span>
          <.icon name="chevron" size={12} open={true} class="account-chevron" />
        </button>
      </div>
    </aside>
    <main class="stage" id="workspace-stage">
      <nav class="workspace-mobile-nav" aria-label="Workspace navigation">
        <button
          type="button"
          class="ghost yard-menu"
          phx-click="yard"
          aria-expanded={to_string(@yard_open)}
          aria-controls="yard"
        >
          <.icon name="chevron" size={13} open={@yard_open} class="ico" />Menu
        </button>
        <.link patch="/home" aria-current={@live_action == :projects && "page"}>Home</.link>
        <.link patch="/schedules">Schedules</.link>
        <.link patch="/inbox" aria-current={@live_action in [:home, :inbox] && "page"}>Inbox</.link>
        <button
          id="mobile-quick-jump-trigger"
          class="ghost"
          data-quick-jump-trigger
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="search"
        >Search</button>
        <button
          class="ghost"
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="new-project"
        >New project</button>
      </nav>
      <div
        id="yard-resize"
        phx-hook="PanelResize"
        class="panel-resize-handle left"
        role="separator"
        tabindex="0"
        aria-label="Sidebar width"
        aria-orientation="vertical"
        data-var="--yard-width"
        data-min="220"
        data-max="480"
        data-key="ravix.panel-width.left"
        data-side="left"
      >
      </div>
      <div
        class="workspace-tabpanel"
        id="project-tabpanel"
        role={@project && "region"}
        aria-labelledby={
          @project &&
            if(@track_id,
              do: "project-track-tab-#{@track_id}",
              else: "project-link-#{@project.id}"
            )
        }
        tabindex={@project && "0"}
      >
        <div :if={@project && is_nil(@track_id) && is_nil(@settings)} class="crumbs">
          <span class="project-mark" aria-hidden="true">
            {String.first(@project.name) |> String.upcase()}
          </span>
          <strong><.project_name project={@project} /></strong><span
            :if={@project.repo}
            class="chip mono"
          >{@project.repo}</span><span class="spacer"></span>
          <.link
            :if={@project.access != :tracks && @live_action != :plans}
            id="crumb-plans"
            class="ghost"
            patch={"/p/#{@project.id}/plans"}
          >
            Plans
          </.link>
          <button
            :if={@project.access != :tracks}
            class="ghost"
            phx-click={JS.push_focus() |> JS.push("dialog")}
            phx-value-name="people"
          >
            People
          </button>
        </div>
        <p
          :if={@project && @project.role != :owner && is_nil(@track_id)}
          id="project-agent-owner"
          class="settings-help"
        >
          This project runs on {@project.owner_login}'s {RavixWeb.AgentName.label(
            @project.runtime
          )}; every turn uses their subscription or API key.
        </p>
        <div :if={@project && @track_id} class="workspace-track-host">
          <%!-- A fixed id, so choosing another track moves this LiveView instead
          of replacing it. The session is its starting point and nothing more:
          it is read once, at mount, and every switch after that arrives as
          `{:select_track, project, track}`. See `hand_over/4`. --%>
          {live_render(@socket, RavixWeb.TrackLive,
            id: "track-host",
            session: %{
              "session_token" => @session_token,
              "track_id" => @track_id,
              "project_id" => @project.id,
              "timezone" => @timezone
            }
          )}
        </div>
        <.live_component
          :if={@project && is_nil(@track_id) && is_nil(@settings)}
          module={RavixWeb.Live.AgentHealth}
          id={"project-agent-health-#{@project.id}"}
          current_user={@current_user}
          session_hash={@session_hash}
          project_id={@project.id}
          refresh={@health_refresh}
        />
        <%!-- Plans are a page of their own, reached from the project row. A
          `?plan=` or `?new=plan` link on the project itself still opens it,
          because track origins stored before the page existed point there. --%>
        <.live_component
          :if={
            @project && is_nil(@track_id) && @project.access != :tracks &&
              (@live_action == :plans || @selected_plan_id || @new_plan)
          }
          module={RavixWeb.Live.PlansPanel}
          id={"plans-#{@project.id}"}
          current_user={@current_user}
          session_hash={@session_hash}
          project={@project}
          plan_id={@selected_plan_id}
          new_plan={@new_plan}
          tracks={@tracks[@project.id] || []}
        />
        <div
          :if={@project && is_nil(@track_id) && @project.access == :tracks}
          class="workspace-project-empty"
        >
          <span class="empty-icon"><.icon name="machine" size={20} /></span>
          <h2>Pick a track</h2>
          <p>
            Each track is its own worktree on this project's machine, with its own branch and its own conversation.
          </p>
          <button
            :if={@project.access != :tracks}
            class="primary"
            phx-click={JS.push_focus() |> JS.push("dialog")}
            phx-value-name="new-track"
          >
            New track
          </button>
          <p :if={@project.access == :tracks}>
            Choose a track shared with you in the tabs above.
          </p>
        </div>
        <section
          :if={
            @project && is_nil(@track_id) && @project.access != :tracks &&
              @live_action != :plans && is_nil(@selected_plan_id) && !@new_plan &&
              is_nil(@settings)
          }
          id="project-start"
          class="first-prompt"
          aria-label="Start work in this project"
        >
          <%= if (@tracks[@project.id] || []) == [] do %>
            <QuickStart.composer
              id="project-quick-start"
              form={@quick_form}
              project={@project}
              busy={@quick_busy}
            />
            <QuickStart.explainer id="project-explainer" />
          <% else %>
            <h2>Recent tracks</h2>
            <ul class="first-prompt-recent">
              <li :for={track <- Enum.take(@tracks[@project.id], 5)}>
                <.link patch={"/p/#{@project.id}/t/#{track.id}"}>
                  <strong>{track.title}</strong> <code class="dimmer">{track.branch}</code>
                </.link>
              </li>
            </ul>
          <% end %>
        </section>
        <div :if={is_nil(@project) && @live_action == :projects} class="centred workspace-home">
          <section
            :if={@rail_loaded && fresh_start?(@projects)}
            id="home-start"
            class="first-prompt"
            aria-labelledby="home-start-h"
          >
            <h1 id="home-start-h">Start your first track</h1>
            <p class="hero-sub">
              Pick a repository and describe the change. Ravix opens a track, and your agent starts there.
            </p>
            <QuickStart.composer
              id="home-quick-start"
              form={@quick_form}
              groups={QuickStart.targets(@repos)}
              loading={@repos_loading}
              busy={@quick_busy}
            />
            <QuickStart.explainer id="home-explainer" />
            <p class="hint first-prompt-alt">
              <button
                class="ghost home-action"
                phx-click={JS.push_focus() |> JS.push("dialog")}
                phx-value-name="new-project"
              >
                <.icon name="plus" size={14} class="ico" /> New project
              </button>
              to add a repository without starting a track yet.
            </p>
          </section>
          <div
            :if={!@rail_loaded || !fresh_start?(@projects)}
            class="hero"
          >
            <div class="home-heading">
              <h1 :if={@rail_loaded}>
                {if @projects == [],
                  do: "What will you build?",
                  else: "Pick up where you left off"}
              </h1>
              <p :if={@rail_loaded && @projects == []} class="hero-sub">
                Start from a repository, or a scratch machine.
              </p>
            </div>
            <div class="home-actions">
              <button
                class="primary home-action"
                phx-click={JS.push_focus() |> JS.push("dialog")}
                phx-value-name="new-project"
              >
                <.icon name="plus" size={16} class="ico" /> New project
              </button>
            </div>
            <section :if={@projects != []} class="home-recent" aria-label="Recent projects">
              <h2>Recent</h2>
              <.link
                :for={project <- Enum.take(@projects, 8)}
                patch={"/p/#{project.id}"}
                class="pick-row"
              >
                <span class="project-mark" aria-hidden="true">
                  {String.first(project.name) |> String.upcase()}
                </span>
                <.project_name project={project} /><span class="meta mono">{project.repo ||
                  "no repository"}</span>
              </.link>
            </section>
          </div>
        </div>
        <.live_component
          :if={@live_action == :schedules}
          module={RavixWeb.Live.SchedulesPanel}
          id="schedules"
          current_user={@current_user}
          timezone={@timezone}
          session_hash={@session_hash}
          projects={@all_projects}
        />
        <%!-- Settings pages, one URL a section (RAV-72). --%>
        <RavixWeb.Live.Settings.page
          :if={@settings}
          settings={@settings}
          project={@project}
          workspace={@current_workspace && @current_workspace.workspace}
          current_user={@current_user}
          session_hash={@session_hash}
        />
        <div
          :if={
            is_nil(@project) &&
              @live_action not in [:projects, :schedules, :user_settings, :workspace_settings]
          }
          class="inbox"
        >
          <header>
            <div class="row">
              <h1>
                Inbox <span :if={@attention > 0} class="badge">{@attention}</span>
              </h1>
            </div>
            <p :if={is_nil(@current_workspace)}>
              Replies, mentions, failed turns and sharing changes across all your projects.
            </p>
            <p :if={@current_workspace}>
              Replies, mentions, failed turns and sharing changes in {@current_workspace.workspace.name}.
            </p>
            <p :if={@other_attention > 0} id="inbox-elsewhere" class="hint">
              {@other_attention} in other workspaces. Switch workspace to see them.
            </p>
          </header>
          <%!-- Nothing is known about the inbox until the rail has been read:
            skeleton cards, never "all caught up" before it has (RAV-67). --%>
          <div
            :if={!@rail_loaded && !@rail_error}
            id="inbox-loading"
            class="inbox-list"
            role="status"
          >
            <span class="sr-only">Loading your inbox…</span>
            <div :for={_ <- 1..3} class="inbox-item inbox-item-skeleton" aria-hidden="true">
              <span class="skeleton skeleton-chip"></span>
              <span class="skeleton skeleton-line"></span>
              <span class="skeleton skeleton-line short"></span>
            </div>
          </div>
          <div :if={@rail_error} id="inbox-error" role="alert" class="inbox-empty">
            <p>The inbox could not be loaded.</p>
            <button type="button" phx-click="refresh">Retry</button>
          </div>
          <div :if={@rail_loaded && @attention == 0} class="inbox-empty">
            <h2>You're all caught up</h2>
            <p>When a track needs your attention, it will appear here.</p>
          </div>
          <div class="inbox-list">
            <div
              :for={notice <- @access_notices}
              id={"access-notice-#{notice.id}"}
              class="inbox-item"
            >
              <div class="row">
                <span class="chip">Access removed</span>
                <span class="spacer"></span><.local_time
                  id={"access-notice-#{notice.id}-at"}
                  at={notice.at}
                  zone={@timezone}
                />
              </div>
              <strong>{notice.track_title}</strong>
              <span :if={notice.revoked != []} class="dim">
                Tracks are now shared with workspace members, so {Enum.map_join(
                  notice.revoked,
                  ", ",
                  &"@#{&1}"
                )} can no longer open this track: they are not in its workspace.
              </span>
              <span :if={notice.withdrawn != []} class="dim">
                Invitations withdrawn: {Enum.map_join(notice.withdrawn, ", ", &"@#{&1}")}.
              </span>
              <div class="row">
                <.link patch={"/w/#{notice.workspace_id}/settings/members"}>Invite them to the workspace</.link>
                <.link patch={"/p/#{notice.project_id}/t/#{notice.track_id}"}>Open track</.link>
                <span class="spacer"></span>
                <button
                  type="button"
                  class="ghost"
                  phx-click="dismiss-access-notice"
                  phx-value-id={notice.id}
                >
                  Dismiss
                </button>
              </div>
            </div>
            <div :for={project <- @projects}>
              <.link
                :for={track <- Enum.filter(@tracks[project.id] || [], &attention?/1)}
                patch={inbox_path(project, track)}
                class="inbox-item"
              >
                <div class="row">
                  <span class="chip">
                    {cond do
                      billing_attention?(track) -> "Reconnect"
                      track.status == :setup_failed -> "Setup failed"
                      track.status == :failed -> "Failed turn"
                      track.mention -> "Mentioned"
                      true -> "Unread reply"
                    end}
                  </span>
                  <span class="dim"><.project_name project={project} /></span><span class="spacer"></span><.inbox_age
                    id={"inbox-age-#{track.id}"}
                    at={inbox_time(track)}
                    zone={@timezone}
                  />
                </div>
                <strong>{track.title}</strong>
                <span :if={track.visibility == :private}><.icon name="lock" /> Private</span><code
                  :if={track.branch != track.title}
                  class="dimmer"
                >{track.branch}</code>
                <span class="dim">
                  <%= cond do %>
                    <% billing_attention?(track) -> %>
                      {track.billing_pause.message} Reconnect it, or open the track to try again.
                    <% track.status == :setup_failed -> %>
                      Setup failed. {track.setup_error} Open the track to Retry setup.
                    <% track.status == :failed -> %>
                      The agent needs a hand. Open the conversation to see what happened.
                    <% track.mention -> %>
                      @{track.mention.author_login} mentioned you in a comment.
                    <% track.reply -> %>
                      <span class="inbox-excerpt" id={"inbox-excerpt-#{track.id}"}>{track.reply.excerpt}</span>
                    <% true -> %>
                      The agent finished. Open the conversation to read its reply.
                  <% end %>
                </span>
              </.link>
            </div>
          </div>
        </div>
      </div>
    </main>
    <.dialog
      :if={@dialog == :sections}
      id="sections-dialog"
      title="Project sections"
      on_close={dismiss(@project, @track_id, @settings)}
    >
      <p class="hint">Organize your sidebar. Sections are visible only to you.</p>
      <form id="new-section-form" phx-submit="create-section">
        <.input
          name="section[name]"
          id="section-name"
          value=""
          label="New section"
          required
          maxlength="80"
        />
        <button class="primary" phx-disable-with="Creating…">Create section</button>
      </form>
      <div :for={section <- @sections} class="section-editor">
        <form id={"rename-section-#{section.id}"} phx-submit="rename-section">
          <input type="hidden" name="section_id" value={section.id} />
          <.input
            name="section[name]"
            id={"section-name-#{section.id}"}
            value={section.name}
            label="Section name"
            required
            maxlength="80"
          />
          <button class="secondary" phx-disable-with="Saving…">Rename</button>
          <button type="button" class="ghost" phx-click="delete-section" phx-value-id={section.id}>Remove section</button>
        </form>
      </div>
      <p :if={@sections != []} class="hint">
        Removing a section keeps its projects in Other projects.
      </p>
      <%!-- Dragging in the sidebar is the quick way; this is the way that
      needs no pointer. --%>
      <div :if={@sections != [] && @projects != []} class="section-editor">
        <h3>Move projects</h3>
        <p class="hint">Or drag a project onto a section in the sidebar.</p>
        <form
          :for={project <- @projects}
          id={"move-project-#{project.id}"}
          phx-change="move-project"
          class="project-section-picker"
        >
          <input type="hidden" name="project" value={project.id} />
          <label for={"project-section-#{project.id}"} class="truncate">
            {project.display_name}
          </label>
          <select
            id={"project-section-#{project.id}"}
            name="section"
            aria-label={"Section for #{project.display_name}"}
          >
            <option value="" selected={is_nil(@section_placements[project.id])}>
              Other projects
            </option>
            <option
              :for={section <- @sections}
              value={section.id}
              selected={@section_placements[project.id] == section.id}
            >
              {section.name}
            </option>
          </select>
        </form>
      </div>
    </.dialog>
    <.dialog
      :if={@dialog == :search}
      id="search-dialog"
      title="Search"
      on_close="dismiss-switcher"
      initial_focus="#search-query"
    >
      <form id="search-form" phx-change="search" phx-submit="search">
        <%!-- Every keystroke re-renders the list below it, which is every
          track of every project this person has. A pause is what somebody
          typing a track name actually wants filtered. --%>
        <.input
          name="q"
          id="search-query"
          value={@query}
          label="Search projects, tracks and plans"
          phx-debounce="150"
        />
      </form>
      <p :if={!@rail_loaded && !@rail_error} role="status">Loading projects…</p>
      <div :if={@rail_error} role="alert">
        <p>Projects could not be loaded.</p><button type="button" phx-click="refresh">Retry</button>
      </div>
      <.track_search_results
        :if={@rail_loaded}
        projects={@projects}
        tracks={@tracks}
        plans={@search_plans}
        query={@query}
        user={@current_user}
      />
    </.dialog>
    <.dialog
      :if={@dialog == :new_project}
      id="new-project-dialog"
      title="New project"
      focus_on_mount={false}
      on_close={dismiss(@project, @track_id, @settings)}
    >
      <p class="lede">A repository, or a scratch machine with nothing cloned yet.</p>
      <RavixWeb.Live.NewProject.render_form
        form_id="new-project-form"
        autofocus={true}
        project_form={@project_form}
        project_agents={@project_agents}
        project_generation={@project_generation}
        project_agent_error={@project_agent_error}
        project_mode={@project_mode}
        current_user={@current_user}
        session_hash={@session_hash}
        repos={@repos}
        repos_loading={@repos_loading}
        installations={@installations}
        installation={@installation}
        busy={@busy}
      />
    </.dialog>
    <%!-- RAV-60: the prompt leads and has focus; the destination, sharing
      and agent are chips whose menus are popovers, and the footer with
      Create never scrolls away. The chips' radios belong to the form by
      `form=`, since the repository's own forms cannot nest inside it. --%>
    <.dialog
      :if={@dialog == :new_track && @track_project}
      id="new-track-dialog"
      title="New track"
      on_close={dismiss(@project, @track_id, @settings)}
      focus_on_mount={false}
    >
      <div class="new-track-chips">
        <RavixWeb.Live.ModelMenu.chip
          id="new-track-repo"
          label={track_destination(@track_project)}
          haspopup="dialog"
          class="pick-chip"
          menu_class="chip-popover-below repo-popover"
          menu_label="Repository"
          disabled={@busy}
        >
          <:trigger>
            <.icon name={if @track_project.repo, do: "folder", else: "machine"} size={13} />
            {track_destination(@track_project)}
          </:trigger>
          <RavixWeb.Live.RepoPicker.picker
            :if={@picker}
            picker={@picker}
            selected={@track_project}
            busy={@busy}
          />
          <form :if={!@picker} id="new-track-project-form" phx-change="new-track-project">
            <label for="new-track-project">Project / repository</label>
            <select id="new-track-project" name="project" disabled={@busy} data-chip-focus>
              <option
                :for={project <- @projects}
                :if={project.access != :tracks}
                value={project.id}
                selected={project.id == @track_project.id}
              >
                {project.display_name}{if project.repo, do: " · #{project.repo}"}
              </option>
            </select>
          </form>
        </RavixWeb.Live.ModelMenu.chip>
        <span class="spacer"></span>
        <RavixWeb.Live.ModelMenu.chip
          :if={private_tracks?(@current_user)}
          id="new-track-sharing"
          label={"Sharing: " <> sharing_label(@track_form.params["visibility"])}
          haspopup="dialog"
          class="pick-chip"
          menu_class="chip-popover-below chip-popover-end"
          menu_label="Sharing"
          disabled={@busy}
        >
          <:trigger>
            <.icon
              name={if @track_form.params["visibility"] == "private", do: "lock", else: "globe"}
              size={13}
            />{sharing_label(@track_form.params["visibility"])}
          </:trigger>
          <fieldset class="chip-group">
            <legend>Who can see this track</legend>
            <label
              :for={{value, title, detail} <- sharing_choices()}
              class="account-item model-option"
            >
              <input
                type="radio"
                class="sr-only"
                name="new_track[visibility]"
                value={value}
                form="new-track-form"
                checked={(@track_form.params["visibility"] || "project") == value}
                data-chip-close
              />
              <span class="chip-choice"><span>{title}</span><small>{detail}</small></span>
              <span class="spacer"></span>
              <span
                :if={(@track_form.params["visibility"] || "project") == value}
                class="check"
                aria-hidden="true"
              >✓</span>
            </label>
          </fieldset>
        </RavixWeb.Live.ModelMenu.chip>
        <span :if={!private_tracks?(@current_user)} class="pick-chip pick-chip-static">
          <.icon name="globe" size={13} />Everyone
          <input type="hidden" name="new_track[visibility]" value="project" form="new-track-form" />
        </span>
      </div>
      <.form
        :let={f}
        for={@track_form}
        id="new-track-form"
        phx-submit="create-track"
        phx-change="edit"
        phx-hook="ProjectFormFocus"
        data-focus="#new-track-prompt"
      >
        <.input
          field={f[:prompt]}
          id="new-track-prompt"
          type="textarea"
          class="new-track-prompt"
          rows="5"
          maxlength="100000"
          phx-hook="SubmitOnEnter"
          phx-debounce="300"
          placeholder="What do you want to work on?"
          aria-label="What do you want to work on?"
          aria-describedby="new-track-prompt-hint"
          disabled={@busy}
        />
        <p id="new-track-prompt-hint" class="sr-only">
          Sent to the agent once setup is ready. Enter creates the track; Shift+Enter adds a line.
        </p>
        <div id="track-advanced" class="track-advanced" hidden={!@advanced_track}>
          <div class="workspace-actions origin-options">
            <button
              :for={{kind, label} <- origin_choices()}
              :if={kind == :blank || @track_project.repo}
              type="button"
              class={if @origin_kind == kind, do: "primary", else: "ghost"}
              phx-click="origin"
              phx-value-kind={kind}
            >
              {label}
            </button>
          </div>
          <.loading_status :if={@refs_loading}>
            Loading {%{branch: "branches", pr: "pull requests", issue: "issues"}[@origin_kind]}…
          </.loading_status>
          <.input
            :if={@origin_kind != :blank}
            field={f[:ref]}
            id="track-ref"
            disabled={@refs_loading}
            label="Start from"
            type="select"
            options={Enum.map(@refs, &{ref_label(&1), ref_id(&1)})}
            required
          />
          <p :if={@reopen && @origin_kind == :branch} id="reopen-hint" class="hint">
            Reopening {@reopen.title}: a new track starts from its branch {@reopen.branch}.
            <span :if={
              !@refs_loading && @refs != [] && !Enum.any?(@refs, &(&1.name == @reopen.branch))
            }>
              That branch isn't on GitHub, so push it first or choose another branch.
            </span>
          </p>
          <p :if={@origin_kind == :blank} class="hint">
            Start from {@track_project.default_branch || "the default branch"}.
          </p>
          <div :if={@origin_kind != :pr}>
            <label for="track-title">Branch name</label>
            <div class="track-branch-input">
              <span id="branch-prefix">ravix/</span>
              <.input
                field={f[:title]}
                id="track-title"
                aria-describedby="branch-prefix branch-hint"
              />
            </div>
            <p id="branch-hint" class="hint">
              {if @origin_kind == :issue,
                do: "Leave empty to use the issue’s number and title.",
                else: "Leave empty for an automatic name (for example, ravix/crewe)."}
            </p>
          </div>
          <p :if={@origin_kind == :pr} class="hint">
            The track uses the pull request's existing branch and name.
          </p>
          <p
            :for={{message, _opts} <- f[:title].errors}
            :if={@origin_kind == :pr}
            class="error fine"
          >
            {message}
          </p>
        </div>
        <.loading_status :if={@busy}>Opening track and preparing its worktree…</.loading_status>
      </.form>
      <RavixWeb.Live.ThreadConnect.panel
        options={@track_options}
        connection={@thread_connect}
        current_user={@current_user}
        session_hash={@session_hash}
      />
      <:footer>
        <RavixWeb.Live.RuntimePicker.menu
          :if={@track_options}
          id="new-track-model"
          options={@track_options}
          params={@track_form.params}
          name="new_track"
          form="new-track-form"
          disabled={@busy}
        />
        <span :if={!@track_options} class="pick-chip pick-chip-static dim">Loading agents…</span>
        <button
          type="button"
          id="new-track-options"
          class="ghost chip-options"
          phx-click="advanced-track"
          aria-expanded={to_string(@advanced_track)}
          aria-controls="track-advanced"
          title={
            if @advanced_track,
              do: "Hide options",
              else:
                "New worktree from #{@track_project.default_branch || "the default branch"}, with an automatic name"
          }
        >
          <.icon name="more" size={14} /><span>Options</span>
        </button>
        <span class="spacer"></span>
        <button
          type="submit"
          form="new-track-form"
          id="new-track-create"
          class="primary"
          aria-label="Create track"
          aria-keyshortcuts="Enter"
          disabled={
            @busy || (@origin_kind != :blank && @refs == []) || creator_blocked?(@track_options)
          }
          phx-disable-with="Opening…"
        >
          {if @busy, do: "Opening track…", else: "Create"}<kbd :if={!@busy} aria-hidden="true">↵</kbd>
        </button>
      </:footer>
    </.dialog>
    <.dialog
      :if={@dialog == :changes}
      id="changes-dialog"
      title="What's new"
      on_close={dismiss(@project, @track_id, @settings)}
    >
      <p class="lede">Changes in Ravix since you last checked.</p>
      <button type="button" class="secondary" phx-click="mark-changes-seen">Mark all as read</button>
      <div class="changes-list">
        <article :for={entry <- @changes} class="change-entry">
          <small>{entry.date} · {entry.kind}</small><h3>{entry.title}</h3>
          <p>{Phoenix.HTML.raw(RavixWeb.Markdown.render_safe(entry.body))}</p>
        </article>
      </div>
    </.dialog>
    <.dialog
      :if={@dialog == :help}
      id="help-dialog"
      title="Help – AI tools"
      on_close={dismiss(@project, @track_id, @settings)}
    >
      <button type="button" class="secondary" phx-click="dialog" phx-value-name="changes">What's new<span
        :if={@changes_unseen > 0}
        class="chip"
      >{@changes_unseen}</span></button>
      <RavixWeb.HelpComponents.agent_tooling />
    </.dialog>
    <.dialog
      :if={@dialog == :account}
      id="account-dialog"
      title="Your account"
      on_close={dismiss(@project, @track_id, @settings)}
    >
      <p class="lede">
        Signed in as <strong>@{@current_user.login}</strong>. Connect either or both agents and choose a default for new projects. Each project uses its selected agent, paid for by its owner’s subscription or API key, whoever is working.
      </p>
      <.live_component
        module={RavixWeb.Live.AgentPanel}
        id="agent-panel"
        initial_agent={@reconnect_agent}
        current_user={@current_user}
        session_hash={@session_hash}
      />
      <hr />
      <p class="account-connections">
        <.link patch="/settings/connected-apps">Manage connected applications →</.link>
        <span class="hint">Review access granted to external tools and disconnect them.</span>
      </p>
      <p class="hint">
        <a href="/api/auth/install">Change which GitHub repositories Ravix may work in ↗</a>
      </p>
    </.dialog>
    <RavixWeb.Live.WorkspaceSwitcher.new_workspace_dialog
      :if={@dialog == :new_workspace}
      on_close={dismiss(@project, @track_id, @settings)}
    />
    <.live_component
      :if={@dialog == :people && @project}
      module={RavixWeb.Live.PeopleDialog}
      id="people"
      scope={:project}
      project={@project}
      subject_id={@project.id}
      current_user={@current_user}
      session_hash={@session_hash}
    />
  </div>
</Layouts.app>
