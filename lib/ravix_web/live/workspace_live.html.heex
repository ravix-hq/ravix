<Layouts.app flash={@flash}>
  <main :if={is_nil(@current_user)} class="centred signin-page">
    <div class="corner-theme"><.theme_picker id="signin-theme" /></div>
    <div class="signin-card">
      <div class="signin-mark"><.wordmark unit={5} /></div>
      <h1>Sign in to Ravix</h1>
      <p class="lede">
        Point Ravix at a repository and it builds you a cloud machine. Every piece of work you start is its own git worktree on that machine, with its own agent, its own branch and its own conversation — so several things can be in flight at once, none of them touching another's files, and the laptop can close.
      </p>
      <a
        :if={@github_available}
        class="landing-button landing-primary gh-button"
        href="/auth/github"
      >
        <.icon name="github" size={17} />Sign in with GitHub
      </a>
      <p :if={!@github_available} class="error">
        GitHub sign-in is not configured for this deployment. Contact the person who runs it to get access.
      </p>
      <ul class="points">
        <li>
          <.icon name="github" size={14} class="ico" />
          <span>
            Sign-in is a GitHub App, so the machine sees the repositories you pick and nothing else. A personal token would have handed it everything you can reach.
          </span>
        </li>
        <li>
          <.icon name="machine" size={14} class="ico" />
          <span>
            The machine is a persistent sandbox with your repository already cloned. It keeps its disk between visits.
          </span>
        </li>
        <li>
          <.icon name="sparkle" size={14} class="ico" />
          <span>
            The agent is Claude Code or Codex, running on your own subscription or API key. Teammates you invite work on your plan, so they need nothing of their own.
          </span>
        </li>
      </ul>
    </div>
  </main>
  <div :if={@current_user} class="app">
    <%!-- On a phone the yard is gone and "Menu" in the mobile nav brings it
      back over the page (`forced`); the scrim behind it, a tap on the x,
      Escape, and any navigation close it again. See `yard_open`. --%>
    <div
      :if={@yard_open}
      class="yard-scrim"
      phx-click="yard-close"
      phx-window-keydown="yard-close"
      phx-key="escape"
      aria-hidden="true"
    >
    </div>
    <aside id="yard" class={["yard", @yard_open && "forced"]} aria-label="Projects">
      <div class="yard-top">
        <span class="avatar workspace-avatar" aria-hidden="true">
          {String.first(@current_user.login) |> String.upcase()}
        </span>
        <div class="yard-who">
          <strong>{@current_user.name || @current_user.login}</strong><small>@{@current_user.login}</small>
        </div>
        <button type="button" class="x yard-close" phx-click="yard-close" aria-label="Close menu">
          <.icon name="x" size={16} />
        </button>
      </div>
      <div class="workspace-actions yard-nav">
        <.link patch="/inbox" class={["yard-item", @live_action in [:home, :inbox] && "on"]}>
          <.icon name="terminal" />Inbox<span class="spacer"></span>
          <span :if={@attention > 0} class="badge">{@attention}</span>
        </.link>
        <.link patch="/home" class={["yard-item", @live_action == :projects && "on"]}>
          <.icon name="home" />Home
        </.link>
        <button
          class="yard-item"
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="new-project"
        >
          <.icon name="plus" />Add a project
        </button>

        <button
          class="yard-item"
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="search"
        >
          <.icon name="search" />Search
        </button>
      </div>
      <div class="yard-scroll">
        <div class="yard-label">
          <span>Projects</span><span class="spacer"></span>
          <div class="row">
            <button
              type="button"
              class="ghost"
              id="manage-sections"
              aria-label="Manage sections"
              title="Manage sections"
              phx-click={JS.push_focus() |> JS.push("dialog")}
              phx-value-name="sections"
            ><.icon name="settings" size={13} /></button>
            <button
              class="ghost"
              aria-label="Add a project"
              phx-click={JS.push_focus() |> JS.push("dialog")}
              phx-value-name="new-project"
            ><.icon name="plus" size={13} /></button>
          </div>
        </div>
        <div id="project-sections" phx-hook="ProjectSections">
          <div
            :for={
              {section, projects} <- section_groups(@projects, @sections, @section_placements)
            }
            :if={section.id || projects != [] || @sections != []}
            class="project-section"
            id={"section-#{section.id || "other"}"}
            data-section-drop={section.id || ""}
          >
            <div :if={section.id || @sections != []} class="yard-label">
              <button
                :if={section.id}
                class="ghost section-toggle"
                phx-click="toggle-section"
                phx-value-id={section.id}
                phx-value-collapsed={to_string(!section.collapsed)}
                aria-expanded={to_string(!section.collapsed)}
                aria-controls={"section-projects-#{section.id}"}
              >
                <.icon name="chevron" size={12} open={!section.collapsed} />
                <span class="truncate">{section.name}</span><span class="dim">{length(projects)}</span>
              </button>
              <span :if={!section.id}>{section.name}</span>
            </div>
            <div id={"section-projects-#{section.id || "other"}"} hidden={section.collapsed}>
              <p :if={section.id && projects == []} class="hint section-empty">
                No projects. Drag one here.
              </p>
              <p :if={!section.id && projects == []} class="hint section-empty">
                Drag a project here to take it out of its section.
              </p>
              <section
                :for={project <- projects}
                class="workspace-project"
                draggable={to_string(@sections != [])}
                data-project-id={project.id}
              >
                <div class="workspace-project-row">
                  <.link
                    patch={"/p/#{project.id}"}
                    class={[
                      "workspace-project-name",
                      @project && @project.id == project.id && "selected"
                    ]}
                  >
                    <span class="project-mark" aria-hidden="true">
                      {String.first(project.name) |> String.upcase()}
                    </span>
                    <span class="truncate"><.project_name project={project} /></span>
                  </.link>
                  <.link
                    :if={project.access != :tracks}
                    patch={"/p/#{project.id}?new=track"}
                    class="project-add"
                    aria-label={"New track in #{project.display_name}"}
                  >
                    <.icon name="plus" size={13} />
                  </.link>
                </div>
                <div
                  :if={@project && @project.id == project.id && project.access != :tracks}
                  class="project-links"
                >
                  <button
                    class="ghost"
                    phx-click={JS.push_focus() |> JS.push("dialog")}
                    phx-value-name="people"
                  >
                    <.icon name="add-person" size={13} />People
                  </button>
                  <button
                    :if={project.role == :owner}
                    class="ghost"
                    phx-click={JS.push_focus() |> JS.push("dialog")}
                    phx-value-name="settings"
                  >
                    <.icon name="settings" size={13} />Project settings
                  </button>
                </div>
              </section>
            </div>
          </div>
        </div>
      </div>
      <div class="workspace-account">
        <.link href="/auth/signout" method="post" class="ghost">Sign out</.link>
        <.theme_picker id="theme-picker" />
        <div id="notify" phx-hook="Notify" class="notify">
          <button
            type="button"
            class="theme-trigger"
            data-notify-toggle
            aria-pressed="false"
            title="Say so from the desktop when a track needs you and this tab is in the background"
          >
            <span class="notify-dot" data-notify-dot></span><span class="col"><small>Desktop notifications</small><span
              class="truncate"
              data-notify-state
            >Off</span></span>
          </button>
        </div>
        <div class="yard-meta">
          <span class="chip">Ravix</span><a href="/api/auth/install">repo access</a><button
            type="button"
            class="linkish"
            phx-click={JS.push_focus() |> JS.push("dialog")}
            phx-value-name="account"
            id="open-account"
          >
            account
          </button>
          <button
            type="button"
            class="linkish"
            phx-click={JS.push_focus() |> JS.push("dialog")}
            phx-value-name="help"
            id="open-help"
          >
            Help
          </button>
          <button
            type="button"
            class="linkish"
            phx-click="dialog"
            phx-value-name="changes"
            aria-label="What's new"
          >What's new<span :if={@changes_unseen > 0} class="chip">{@changes_unseen}</span></button>
        </div>
      </div>
    </aside>
    <main class="stage" id="workspace-stage">
      <nav class="workspace-mobile-nav" aria-label="Workspace navigation">
        <button
          type="button"
          class="ghost yard-menu"
          phx-click="yard"
          aria-expanded={to_string(@yard_open)}
          aria-controls="yard"
        >
          <.icon name="chevron" size={13} open={@yard_open} class="ico" />Menu
        </button>
        <.link patch="/home">Home</.link><.link patch="/inbox">Inbox</.link><button
          class="ghost"
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="search"
        >Tracks</button><button
          class="ghost"
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="new-project"
        >New project</button>
      </nav>
      <div
        id="yard-resize"
        phx-hook="PanelResize"
        class="panel-resize-handle left"
        role="separator"
        tabindex="0"
        aria-label="Sidebar width"
        aria-orientation="vertical"
        data-var="--yard-width"
        data-min="220"
        data-max="480"
        data-key="ravix.panel-width.left"
        data-side="left"
      >
      </div>
      <nav
        :if={@project}
        id="project-track-navigation"
        phx-hook="TrackTabs"
        class="track-navigation"
        aria-label="Project tracks"
      >
        <button
          type="button"
          class="ghost track-scroll"
          data-scroll-left
          aria-label="Scroll tracks left"
          aria-controls="project-track-tabs"
          disabled
        >‹</button>
        <div id="project-track-tabs" class="track-tabs">
          <.link
            patch={"/p/#{@project.id}"}
            class={["track-tab", is_nil(@track_id) && "selected"]}
            aria-current={if is_nil(@track_id), do: "page"}
          >Overview</.link>
          <.link
            :for={{track, index} <- Enum.with_index(@tracks[@project.id] || [], 1)}
            patch={"/p/#{@project.id}/t/#{track.id}"}
            class={["workspace-track track-tab", @track_id == track.id && "selected"]}
            aria-current={if @track_id == track.id, do: "page"}
          >
            <span
              :if={track.status in [:running, :opening]}
              class={"dot #{track.status}"}
              role="img"
              aria-label="Working"
            ></span>
            <span
              :if={attention?(track)}
              class="track-attention"
              role="img"
              aria-label="Needs attention"
            >
              !
            </span>
            <span
              :if={track.status not in [:running, :opening] && !attention?(track)}
              class="track-num"
            >
              {index}
            </span>
            <span class="track-title">{track.title}</span>
            <span :if={track.origin.kind == :plan} class="chip" title="From a project plan">Plan</span>
          </.link>
          <button
            :if={@project.access != :tracks}
            class="ghost track-tab"
            phx-click={JS.push_focus() |> JS.push("dialog")}
            phx-value-name="new-track"
          ><.icon name="plus" size={13} />New track</button>
        </div>
        <button
          type="button"
          class="ghost track-scroll"
          data-scroll-right
          aria-label="Scroll tracks right"
          aria-controls="project-track-tabs"
          disabled
        >›</button>
      </nav>
      <div :if={@project && is_nil(@track_id)} class="crumbs">
        <span class="project-mark" aria-hidden="true">
          {String.first(@project.name) |> String.upcase()}
        </span>
        <strong><.project_name project={@project} /></strong><span
          :if={@project.repo}
          class="chip mono"
        >{@project.repo}</span><span class="spacer"></span>
        <button
          :if={@project.access != :tracks}
          class="ghost"
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="people"
        >
          People
        </button>
        <button
          :if={@project.role == :owner}
          class="ghost"
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="settings"
        >
          Settings
        </button>
      </div>
      <div :if={@project && @track_id} class="workspace-track-host">
        <%!-- A fixed id, so choosing another track moves this LiveView instead
          of replacing it. The session is its starting point and nothing more:
          it is read once, at mount, and every switch after that arrives as
          `{:select_track, project, track}`. See `hand_over/3`. --%>
        {live_render(@socket, RavixWeb.TrackLive,
          id: "track-host",
          session: %{
            "session_token" => @session_token,
            "track_id" => @track_id,
            "project_id" => @project.id
          }
        )}
      </div>
      <.live_component
        :if={@project && is_nil(@track_id) && @project.access != :tracks}
        module={RavixWeb.Live.PlansPanel}
        id={"plans-#{@project.id}"}
        current_user={@current_user}
        session_hash={@session_hash}
        project={@project}
        plan_id={@selected_plan_id}
        tracks={@tracks[@project.id] || []}
      />
      <div
        :if={@project && is_nil(@track_id) && @project.access == :tracks}
        class="workspace-project-empty"
      >
        <span class="empty-icon"><.icon name="machine" size={20} /></span>
        <h2>Pick a track</h2>
        <p>
          Each track is its own worktree on this project's machine, with its own branch and its own conversation.
        </p>
        <button
          :if={@project.access != :tracks}
          class="primary"
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="new-track"
        >
          New track
        </button>
        <p :if={@project.access == :tracks}>Choose a track shared with you in the tabs above.</p>
      </div>
      <div :if={is_nil(@project) && @live_action == :projects} class="centred workspace-home">
        <div class="hero">
          <.wordmark />
          <p class="hero-sub">
            A project is a machine. A track is a worktree on it. Start as many as you like — they share one disk and take it in turns.
          </p>
          <div class="home-actions">
            <button
              class="home-action"
              phx-click={JS.push_focus() |> JS.push("dialog")}
              phx-value-name="new-project"
            >
              <.icon name="globe" size={18} class="ico" />
              <span>
                <strong>Open a GitHub project</strong><small>Pick a repository Ravix can see and it builds the machine. Connect GitHub to choose which repositories it can access.</small>
              </span>
            </button>
            <button
              class="home-action"
              phx-click={JS.push_focus() |> JS.push("dialog")}
              phx-value-name="new-project"
            >
              <.icon name="folder-plus" size={18} class="ico" />
              <span>
                <strong>Quick start</strong><small>A machine with no repository. Somewhere to try things, or to start something new.</small>
              </span>
            </button>
            <button class="home-action" disabled>
              <.icon name="folder" size={18} class="ico" />
              <span>
                <strong>Open a local project</strong><small>The machine is in the cloud, so there is no folder on this computer for it to open. Push the repository and open it from GitHub.</small>
              </span>
            </button>
          </div>
          <section :if={@projects != []} class="home-recent" aria-label="Recent projects">
            <h2>Recent</h2>
            <.link
              :for={project <- Enum.take(@projects, 8)}
              patch={"/p/#{project.id}"}
              class="pick-row"
            >
              <span class="project-mark" aria-hidden="true">
                {String.first(project.name) |> String.upcase()}
              </span>
              <.project_name project={project} /><span class="meta mono">{project.repo ||
                "no repository"}</span>
            </.link>
          </section>
        </div>
      </div>
      <div :if={is_nil(@project) && @live_action != :projects} class="inbox">
        <header>
          <div class="row">
            <h1>
              Inbox <span :if={@attention > 0} class="badge">{@attention}</span>
            </h1>
            <span class="spacer"></span><button class="ghost" phx-click="refresh">Refresh</button>
          </div>
          <p>Replies and failed turns across all your projects.</p>
        </header>
        <div :if={@attention == 0} class="inbox-empty">
          <h2>You're all caught up</h2>
          <p>When a track needs your attention, it will appear here.</p>
        </div>
        <div class="inbox-list">
          <div :for={project <- @projects}>
            <.link
              :for={track <- Enum.filter(@tracks[project.id] || [], &attention?/1)}
              patch={"/p/#{project.id}/t/#{track.id}"}
              class="inbox-item"
            >
              <div class="row">
                <span class="chip">
                  {if track.status == :failed, do: "Failed turn", else: "Unread reply"}
                </span>
                <span class="dim"><.project_name project={project} /></span><span class="spacer"></span><time
                  :if={track.last_active_at}
                  datetime={DateTime.to_iso8601(track.last_active_at)}
                >{Calendar.strftime(track.last_active_at, "%b %-d, %H:%M UTC")}</time>
              </div>
              <strong>{track.title}</strong><code class="dimmer">{track.branch}</code><span class="dim">{if track.status ==
                                                                                                              :failed,
                                                                                                            do:
                                                                                                              "The agent needs a hand. Open the conversation to see what happened.",
                                                                                                            else:
                                                                                                              "The agent finished. Open the conversation to read its reply."}</span>
            </.link>
          </div>
        </div>
      </div>
    </main>
    <.dialog
      :if={@dialog == :sections}
      id="sections-dialog"
      title="Project sections"
      on_close="dismiss"
    >
      <p class="hint">Organize your sidebar. Sections are visible only to you.</p>
      <form id="new-section-form" phx-submit="create-section">
        <.input
          name="section[name]"
          id="section-name"
          value=""
          label="New section"
          required
          maxlength="80"
        />
        <button class="primary" phx-disable-with="Creating…">Create section</button>
      </form>
      <div :for={section <- @sections} class="section-editor">
        <form id={"rename-section-#{section.id}"} phx-submit="rename-section">
          <input type="hidden" name="section_id" value={section.id} />
          <.input
            name="section[name]"
            id={"section-name-#{section.id}"}
            value={section.name}
            label="Section name"
            required
            maxlength="80"
          />
          <button class="secondary" phx-disable-with="Saving…">Rename</button>
          <button type="button" class="ghost" phx-click="delete-section" phx-value-id={section.id}>Remove section</button>
        </form>
      </div>
      <p :if={@sections != []} class="hint">
        Removing a section keeps its projects in Other projects.
      </p>
      <%!-- Dragging in the sidebar is the quick way; this is the way that
      needs no pointer. --%>
      <div :if={@sections != [] && @projects != []} class="section-editor">
        <h3>Move projects</h3>
        <p class="hint">Or drag a project onto a section in the sidebar.</p>
        <form
          :for={project <- @projects}
          id={"move-project-#{project.id}"}
          phx-change="move-project"
          class="project-section-picker"
        >
          <input type="hidden" name="project" value={project.id} />
          <label for={"project-section-#{project.id}"} class="truncate">
            {project.display_name}
          </label>
          <select
            id={"project-section-#{project.id}"}
            name="section"
            aria-label={"Section for #{project.display_name}"}
          >
            <option value="" selected={is_nil(@section_placements[project.id])}>
              Other projects
            </option>
            <option
              :for={section <- @sections}
              value={section.id}
              selected={@section_placements[project.id] == section.id}
            >
              {section.name}
            </option>
          </select>
        </form>
      </div>
    </.dialog>
    <.dialog :if={@dialog == :search} id="search-dialog" title="Find a track" on_close="dismiss">
      <form id="search-form" phx-change="search">
        <%!-- Every keystroke re-renders the list below it, which is every
          track of every project this person has. A pause is what somebody
          typing a track name actually wants filtered. --%>
        <.input
          name="q"
          id="search-query"
          value={@query}
          label="Search projects and tracks"
          phx-debounce="150"
          autofocus
        />
      </form>
      <div :for={project <- @projects}>
        <.link
          :for={track <- Enum.filter(@tracks[project.id] || [], &matching?(&1, project, @query))}
          patch={"/p/#{project.id}/t/#{track.id}"}
          class="workspace-track"
        >
          <.project_name project={project} /> / {track.title}
        </.link>
      </div>
    </.dialog>
    <.dialog
      :if={@dialog == :new_project}
      id="new-project-dialog"
      title="New project"
      on_close="dismiss"
    >
      <.loading_status :if={@repos_loading}>Loading GitHub repositories…</.loading_status>
      <form :if={@installations != []} id="installation-form" phx-change="installation">
        <.input
          name="installation"
          id="installation"
          label="GitHub account"
          type="select"
          value={@installation}
          options={Enum.map(@installations, &{&1.account, &1.id})}
        />
      </form>
      <.form
        :let={f}
        for={@project_form}
        id="new-project-form"
        phx-submit="create-project"
        phx-change="edit"
      >
        <.input field={f[:name]} id="project-name" label="Project name" maxlength="120" />
        <.input
          field={f[:repo]}
          id="project-repo"
          disabled={@repos_loading}
          label="Repository"
          type="select"
          options={[
            {"No repository (scratch)", ""} | Enum.map(@repos, &{&1.full_name, &1.full_name})
          ]}
        />
        <p><a href="/api/auth/install">Connect or manage GitHub repositories ↗</a></p>
        <p
          :if={!Ravix.Accounts.Inference.connected?(@current_user)}
          class="hint"
          id="new-project-no-agent"
        >
          You have not connected an agent, so this project's agent may have nothing to run on.
          <button
            type="button"
            class="linkish"
            phx-click={JS.push_focus() |> JS.push("dialog")}
            phx-value-name="account"
          >
            Connect Claude Code or Codex
          </button>
        </p>
        <.loading_status :if={@busy}>Creating project and preparing its machine…</.loading_status>
        <button class="primary" disabled={@busy || @repos_loading} phx-disable-with="Creating…">
          {if @busy, do: "Creating project…", else: "Create project"}
        </button>
      </.form>
    </.dialog>
    <.dialog
      :if={@dialog == :new_track && @project}
      id="new-track-dialog"
      title="New track"
      on_close="dismiss"
    >
      <.form
        :let={f}
        for={@track_form}
        id="new-track-form"
        phx-submit="create-track"
        phx-change="edit"
      >
        <div :if={@origin_kind != :pr} hidden={!@advanced_track}>
          <label for="track-title">Branch name</label>
          <div class="workspace-actions">
            <span id="branch-prefix">ravix/</span>
            <.input
              field={f[:title]}
              id="track-title"
              aria-describedby="branch-prefix branch-hint"
            />
          </div>
          <p id="branch-hint" class="hint">
            Leave empty for a suggested name (for example, ravix/crewe), or an issue's number and title.
          </p>
        </div>
        <p :if={@origin_kind == :pr} class="hint">
          The track uses the pull request's existing branch and name.
        </p>
        <p
          :for={{message, _opts} <- f[:title].errors}
          :if={@origin_kind == :pr}
          class="error fine"
        >
          {message}
        </p>
        <p :if={@origin_kind == :blank} class="hint">
          New worktree from {@project.default_branch || "the default branch"}, with an automatic name matching its directory.
        </p>
        <button
          type="button"
          class="ghost"
          phx-click="advanced-track"
          aria-expanded={to_string(@advanced_track)}
          aria-controls="track-advanced"
        >
          {if @advanced_track, do: "Hide advanced", else: "Advanced"}
        </button>
        <div id="track-advanced" hidden={!@advanced_track}>
          <div class="workspace-actions origin-options">
            <button
              :for={{kind, label} <- origin_choices()}
              :if={kind == :blank || @project.repo}
              type="button"
              class={if @origin_kind == kind, do: "primary", else: "ghost"}
              phx-click="origin"
              phx-value-kind={kind}
            >
              {label}
            </button>
          </div>
          <.loading_status :if={@refs_loading}>
            Loading branches, pull requests or issues…
          </.loading_status>
          <.input
            :if={@origin_kind != :blank}
            field={f[:ref]}
            id="track-ref"
            disabled={@refs_loading}
            label="Start from"
            type="select"
            options={Enum.map(@refs, &{ref_label(&1), ref_id(&1)})}
            required
          />
        </div>
        <.loading_status :if={@busy}>Opening track and preparing its worktree…</.loading_status>
        <button
          class="primary"
          disabled={@busy || (@origin_kind != :blank && @refs == [])}
          phx-disable-with="Opening…"
        >
          {if @busy, do: "Opening track…", else: "Create track"}
        </button>
      </.form>
    </.dialog>
    <.live_component
      :if={@dialog == :settings && @project}
      module={RavixWeb.Live.SettingsDialog}
      id="settings-dialog-panel"
      project={@project}
      current_user={@current_user}
      session_hash={@session_hash}
    />
    <.dialog :if={@dialog == :changes} id="changes-dialog" title="What's new" on_close="dismiss">
      <p class="lede">Changes in Ravix since you last checked.</p>
      <button type="button" class="secondary" phx-click="mark-changes-seen">Mark all as read</button>
      <div class="changes-list">
        <article :for={entry <- @changes} class="change-entry">
          <small>{entry.date} · {entry.kind}</small><h3>{entry.title}</h3>
          <p>{Phoenix.HTML.raw(RavixWeb.Markdown.render_safe(entry.body))}</p>
        </article>
      </div>
    </.dialog>
    <.dialog :if={@dialog == :help} id="help-dialog" title="Help · AI tools" on_close="dismiss">
      <button type="button" class="secondary" phx-click="dialog" phx-value-name="changes">What's new<span
        :if={@changes_unseen > 0}
        class="chip"
      >{@changes_unseen}</span></button>
      <RavixWeb.HelpComponents.agent_tooling />
    </.dialog>
    <.dialog :if={@dialog == :account} id="account-dialog" title="Your account" on_close="dismiss">
      <a href="/settings/connections">Connected applications</a>
      <p class="lede">
        Signed in as <strong>@{@current_user.login}</strong>. The agent below is the one your projects are built with, and its subscription or key is what pays for every turn in them, whoever is working.
      </p>
      <.live_component
        module={RavixWeb.Live.AgentPanel}
        id="agent-panel"
        current_user={@current_user}
        session_hash={@session_hash}
      />
      <hr />
      <p class="hint">
        <a href="/api/auth/install">Change which GitHub repositories Ravix may work in ↗</a>
      </p>
    </.dialog>
    <.live_component
      :if={@dialog == :people && @project}
      module={RavixWeb.Live.PeopleDialog}
      id="people"
      scope={:project}
      project={@project}
      subject_id={@project.id}
      owner={@project.role == :owner}
      current_user={@current_user}
      session_hash={@session_hash}
    />
  </div>
</Layouts.app>
