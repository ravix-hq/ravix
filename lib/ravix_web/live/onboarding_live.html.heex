<Layouts.app flash={@flash} stale_assets={@static_changed?}>
  <main :if={@current_user} class="centred welcome-page">
    <div class="welcome-card">
      <header class="welcome-head">
        <.wordmark size={24} />
        <span class="spacer"></span>
        <.link href="/auth/signout" method="post" class="ghost">Sign out</.link>
        <button class="ghost" phx-click="skip" id="welcome-skip">Skip setup</button>
      </header>

      <nav class="welcome-steps" aria-label="Setup progress">
        <ol>
          <li
            :for={{step, to} <- steps()}
            class={[
              step == @live_action && "on",
              position(step) < position(@live_action) && "done"
            ]}
            aria-current={step == @live_action && "step"}
          >
            <.link
              patch={if step == :intro, do: to <> "?from=start", else: to}
              aria-label={"Step #{position(step)}: #{step_name(step)}"}
            >
              <span class="welcome-step-num" aria-hidden="true">{position(step)}</span>
              <span>{step_name(step)}</span>
            </.link>
          </li>
        </ol>
      </nav>

      <section :if={@live_action == :intro} id="welcome-intro" aria-labelledby="welcome-intro-h">
        <h1 id="welcome-intro-h">
          Welcome to Ravix, {@current_user.name || @current_user.login}
        </h1>
        <p class="lede">
          Describe a change. Ravix opens a branch, and your agent starts there.
        </p>
        <RavixWeb.OnboardingComponents.workflow_preview id="welcome-workflow" />
        <div class="welcome-actions">
          <.link patch={path(:agent)} class="welcome-primary" id="welcome-start">
            Set up your agent
          </.link>
        </div>
      </section>

      <section :if={@live_action == :agent} id="welcome-agent" aria-labelledby="welcome-agent-h">
        <h1 id="welcome-agent-h">Connect your agent</h1>
        <p class="lede">
          Ravix runs Claude Code or Codex on your own subscription. Connect one to continue; the first becomes your default.
        </p>
        <.live_component
          module={RavixWeb.Live.AgentPanel}
          id="agent-panel"
          onboarding={true}
          compact={true}
          current_user={@current_user}
          session_hash={@session_hash}
        />

        <div class="welcome-actions">
          <.link patch={path(:intro) <> "?from=start"} class="ghost">Back</.link>
          <span class="spacer"></span>
          <.link
            patch={path(:github)}
            class={if Inference.connected?(@current_user), do: "welcome-primary", else: "ghost"}
            id="agent-later"
          >
            {if Inference.connected?(@current_user),
              do: "Continue",
              else: "I'll do this later"}
          </.link>
        </div>
      </section>

      <section
        :if={@live_action == :github}
        id="welcome-github"
        aria-labelledby="welcome-github-h"
      >
        <h1 id="welcome-github-h">Connect GitHub</h1>
        <p class="lede">
          Signing in told Ravix who you are. Installing the Ravix GitHub App is the separate step that says which repositories it may work in. You choose them on GitHub, and you can change the list there at any time.
        </p>
        <p :if={!@github_available} class="error">
          GitHub is not configured for this deployment, so there are no repositories to connect. You can still start a track on a scratch machine, with no repository.
        </p>
        <p :if={@github_available && is_nil(@installations)} class="hint" id="github-checking">
          Checking what Ravix can already see…
        </p>
        <div :if={@github_available && @installations == []} id="github-none">
          <a class="welcome-primary" href="/api/auth/install">
            <.icon name="github" size={17} />Install the GitHub App
          </a>
          <p class="hint">
            You will leave for GitHub, pick an account and its repositories, and come back here.
          </p>
        </div>
        <div :if={@github_available && @installations not in [nil, []]} id="github-connected">
          <p class="welcome-connected">
            <.icon name="check" size={14} class="ico" />
            Connected to {Enum.map_join(@installations, ", ", & &1.account)}.
          </p>
          <div
            :for={{inside, outside} <- in_workspace(@installations, @workspace_github)}
            id="github-workspace"
          >
            <p :if={inside != []} id="github-workspace-in">
              {@workspace_github.workspace.name} uses {handles(inside)}.
            </p>
            <p :if={outside != []} class="hint" id="github-workspace-out">
              Not in {@workspace_github.workspace.name} yet: {handles(outside)}.
              <.link
                :if={@workspace_github.owner?}
                navigate={"/w/#{@workspace_github.workspace.id}/settings/repositories"}
              >
                Add to workspace
              </.link>
              <span :if={!@workspace_github.owner?}>A workspace owner can add them.</span>
            </p>
          </div>
          <p class="hint">
            <a href="/api/auth/install">Add another account, or change which repositories ↗</a>
          </p>
        </div>
        <div class="welcome-actions">
          <.link patch={path(:agent)} class="ghost">Back</.link>
          <span class="spacer"></span>
          <.link
            patch={path(:project)}
            class={
              if @installations not in [nil, []],
                do: "welcome-primary",
                else: "ghost"
            }
            id="github-continue"
          >
            {if @installations not in [nil, []], do: "Continue", else: "Continue without GitHub"}
          </.link>
        </div>
      </section>

      <section
        :if={@live_action == :project}
        id="welcome-project"
        aria-labelledby="welcome-project-h"
      >
        <h1 id="welcome-project-h">What do you want to work on?</h1>
        <p class="lede">
          Pick a repository and say what you want done. Ravix builds its machine and opens a track, and your agent starts as soon as setup is ready.
        </p>
        <form
          :if={length(@installations || []) > 1}
          id="installation-form"
          phx-change="installation"
        >
          <.input
            name="installation"
            id="installation"
            label="GitHub account"
            type="select"
            value={@installation}
            options={Enum.map(@installations, &{&1.account, &1.id})}
          />
        </form>
        <RavixWeb.Live.QuickStart.composer
          id="first-prompt"
          form={@quick_form}
          groups={targets(@repos)}
          repos={@repos}
          loading={@repos_loading}
          busy={@quick_busy}
          disabled={!Inference.connected?(@current_user)}
          class="welcome-quick-start"
          submit_class="primary welcome-primary"
        >
          <:notice>
            <p
              :if={!Inference.connected?(@current_user)}
              class="welcome-warning"
              id="first-prompt-no-agent"
            >
              <.icon name="info" size={14} class="ico" />
              <span>
                Every track runs on your agent. <.link patch={path(:agent)}>Connect one</.link>
                to start.
              </span>
            </p>
          </:notice>
        </RavixWeb.Live.QuickStart.composer>
        <div class="welcome-actions">
          <.link patch={path(:github)} class="ghost">Back</.link>
        </div>
      </section>
    </div>
  </main>
</Layouts.app>
