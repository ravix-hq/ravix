<div class="track-workspace">
  <%!-- No toasts here: this page's flash goes up to the workspace, which
    draws the one stack for the whole page. See `RavixWeb.Live.Result.flash/3`. --%>
  <%!-- The wait before the track's own detail lands, drawn in the shape the
  track itself will have rather than as a word in the middle of an empty
  page. The two columns and the header strip are what the layout is; leaving
  them out meant every track switch collapsed the page to one centred line
  and then reflowed it back, which read as the whole screen reloading even
  once the wait behind it got short. --%>
  <div :if={@loading && is_nil(@track)} class="track-workspace-body" aria-busy="true">
    <header class="crumbs track-crumbs"></header>
    <div class="split">
      <section class="track-conversation" aria-label="Conversation">
        <div class="transcript-scroll">
          <p class="workspace-welcome" role="status">Loading track…</p>
        </div>
      </section>
      <aside class="inspector" aria-label="Track inspector"></aside>
    </div>
  </div>
  <div :if={!@loading && is_nil(@track)} class="workspace-welcome">
    <p>Could not load this track.</p>
    <button class="primary" phx-click="retry-load">Try again</button>
  </div>
  <div :if={@track} class="track-workspace-body">
    <header class="crumbs track-crumbs">
      <.link navigate={"/p/#{@project.id}"} class="project-crumb">
        <span class="project-mark" aria-hidden="true">
          {String.first(@project.name) |> String.upcase()}
        </span>
        <strong>{project_label(@project)}</strong>
      </.link>
      <span class="dimmer" aria-hidden="true">›</span>
      <button
        :if={owner_or_creator?(@current_user, @track)}
        class="ghost"
        phx-click={JS.push_focus() |> JS.push("dialog")}
        phx-value-name="rename"
      >
        {@track.title}
      </button>
      <strong :if={!owner_or_creator?(@current_user, @track)}>{@track.title}</strong>
      <span class="chip mono track-branch" title={@track.branch}>{@track.branch}</span>
      <span class="spacer"></span><button
        class="ghost"
        phx-click={JS.push_focus() |> JS.push("dialog")}
        phx-value-name="people"
        aria-label={"People (#{length(@present)})"}
        title="People on this track"
      ><.icon name="add-person" size={15} /><span>{length(@present)}</span></button>
      <button
        :if={@project.access != :tracks}
        class="ghost"
        phx-click={JS.push_focus() |> JS.push("dialog", target: "#workspace-stage")}
        phx-value-name="new-track"
      >
        <.icon name="plus" size={13} />New track
      </button>
      <button
        :if={@project.role == :owner}
        class="ghost"
        phx-click={JS.push_focus() |> JS.push("dialog", target: "#workspace-stage")}
        phx-value-name="settings"
      >
        Settings
      </button>
      <button
        :if={owner_or_creator?(@current_user, @track)}
        class="ghost"
        phx-click={JS.push_focus() |> JS.push("dialog")}
        phx-value-name="close"
      >
        Close track
      </button>
    </header>
    <div class="split">
      <section class="track-conversation" aria-label="Conversation">
        <%!-- `data-track` is how the scroll hook learns it is somewhere new.
          This element keeps its id across a track switch now --- the page
          moves rather than being rebuilt --- so without it a reader who had
          scrolled up in one track would arrive part-way up the next one. See
          `assets/js/hooks/transcript_tail.js`. --%>
        <div
          id="transcript-scroll"
          phx-hook="TranscriptTail"
          class="transcript-scroll"
          data-track={@track.id}
        >
          <div class="track-ribbon">
            <p :if={@header && @header.copy_of} class="track-copy">
              You are in a copy of {@header.copy_of} called
              <code>{Path.basename(@track.workdir)}</code>
            </p>
            <div class="ribbon-line">
              <.icon name="folder" size={13} /><span>Created <code>{@track.workdir}</code></span>
            </div>
            <span
              :if={@track.stale}
              class="chip"
            >
              Settings changed — open a new track to use them
            </span>
          </div>
          <div id="transcript-turns" phx-update="stream">
            <article :for={{dom_id, turn} <- @streams.turns} id={dom_id} class="workspace-turn">
              <.prompt_message :if={turn.prompt} prompt={turn.prompt} />
              <section :if={turn.blocks != []} class="agent-terminal" aria-label="Agent output">
                <div class="agent-terminal-label">
                  <.icon name="terminal" size={12} /><span>agent</span>
                </div>
                <div class="agent-terminal-output">
                  <div :for={block <- turn.blocks}>
                    <.block block={block} html={rendered(@rendered, block)} />
                  </div>
                </div>
              </section>
            </article>
          </div>
          <%!-- Shown by `assets/js/hooks/transcript_tail.js` once the reader
            has scrolled up: it toggles `unpinned` on the scroller, and the
            stylesheet shows this only under that class. A click re-pins. --%>
          <button type="button" class="jump-latest" data-jump-latest>
            <.icon name="arrow-up" size={12} class="ico" />Jump to latest
          </button>
          <p :if={@transcript_loading} class="workspace-welcome" role="status">
            Loading conversation…
          </p>
          <%!-- Only once the transcript has actually been read. An empty
            `@page` is also what a track that is still loading one has, and
            offering the starters for a conversation with a year of history
            in it --- for the moment before the read answers --- is a worse
            answer than saying nothing yet. --%>
          <div :if={!@transcript_loading && @page.turns == []} class="workspace-welcome">
            <h2>What would you like to work on?</h2>
            <button
              :for={starter <- @starters}
              class="ghost"
              phx-click="starter"
              phx-value-prompt={starter.prompt}
            >
              {starter.label}
            </button>
          </div>
        </div>
        <div :if={@queue != []} class="workspace-queue">
          <div :for={item <- @queue}>
            <span class="chip">{item.status}</span> {item.prompt}
            <span :if={item.error}>{item.error}</span>
            <button
              :if={item.can_cancel}
              class="ghost"
              phx-click="queue"
              phx-value-action="cancel"
              phx-value-id={item.id}
            >
              Cancel
            </button>
            <button
              :if={item.can_cancel && item.status in [:failed, :unconfirmed]}
              class="ghost"
              phx-click="queue"
              phx-value-action="retry"
              phx-value-id={item.id}
            >
              Retry
            </button>
          </div>
        </div>
        <%!-- The one thing a reader who is not looking should hear: a turn
          ended. Polite, so it waits for whatever is being read; visually
          hidden, because the transcript already shows it. --%>
        <div id="transcript-status" class="sr-only" role="status" aria-live="polite">
          {@announcement}
        </div>
        <div class="workspace-composer">
          <p :for={person <- Enum.filter(@present, & &1.typing)} class="hint">
            @{person.login} is typing…
          </p>
          <%!-- `phx-change` is what `allow_upload/3` needs to see an image
            being chosen, and the textarea's own share of it is a round trip
            per keystroke carrying the whole prompt --- which `handle_event`
            for "validate" looks at and does nothing with. A long instruction
            was sent over the socket once per character typed. `blur` is the
            debounce that says what is true: the server has no use for this
            box until it is submitted, and the draft is kept in the browser
            by `assets/js/hooks/composer.js` meanwhile. --%>
          <form id="composer-form" phx-submit="send" phx-change="validate">
            <div class="composer-box" data-composer-box>
              <div class="composer-note" role="status" data-composer-note hidden></div>
              <textarea
                id={"composer-#{@track.id}"}
                phx-hook="Composer"
                name="text"
                rows="2"
                phx-debounce="blur"
                placeholder="Ask for a change, or a question about this branch"
                aria-label="Message"
                data-draft-key={"track:#{@track.id}"}
                data-typing-event="typing"
                disabled={is_nil(@track.conversation_id)}
              ></textarea>
              <.live_file_input upload={@uploads.images} aria-label="Attach images" />
              <div :for={entry <- @uploads.images.entries} class="workspace-upload">
                <span>{entry.client_name} ({entry.progress}%)</span><button
                  type="button"
                  class="ghost"
                  phx-click="cancel-upload"
                  phx-value-ref={entry.ref}
                >Remove</button>
                <p :for={err <- upload_errors(@uploads.images, entry)} role="alert">
                  {upload_error(err)}
                </p>
              </div>
              <p :for={err <- upload_errors(@uploads.images)} role="alert">{upload_error(err)}</p>
              <p :if={@attached_images != []}>
                {length(@attached_images)} attached image(s) retained for retry.
                <button type="button" class="ghost" phx-click="clear-attachments">
                  Remove retained images
                </button>
              </p>
              <div class="workspace-actions">
                <button
                  type="button"
                  class="ghost"
                  aria-label="Choose images"
                  phx-click={JS.dispatch("click", to: "##{@uploads.images.ref}")}
                >
                  <.icon name="picture" size={17} />
                </button>
                <span class="composer-model mono">{@project.model}</span><span class="send-hint"><kbd>Enter</kbd>
                to send</span><span class="spacer"></span>
                <button
                  class="primary"
                  aria-label="Send"
                  phx-disable-with="Sending…"
                  disabled={is_nil(@track.conversation_id)}
                >
                  <.icon name="arrow-up" size={16} />
                </button>
                <button
                  :if={@track.status in [:running, :opening]}
                  type="button"
                  class="ghost"
                  phx-click="interrupt"
                  disabled={:interrupt in @pending}
                >
                  Stop
                </button>
                <button
                  :if={@track.status in [:failed, :opening]}
                  type="button"
                  class="ghost"
                  phx-click="retry-track"
                  disabled={:retry in @pending}
                >
                  Wake / retry
                </button>
              </div>
            </div>
          </form>
        </div>
      </section>
      <aside class="inspector" aria-label="Track inspector">
        <div
          id="inspector-resize"
          phx-hook="PanelResize"
          class="panel-resize-handle right"
          role="separator"
          tabindex="0"
          aria-label="Inspector width"
          aria-orientation="vertical"
          data-var="--inspector-width"
          data-min="300"
          data-max="900"
          data-key="ravix.panel-width.right"
          data-side="right"
        >
        </div>
        <nav class="workspace-tabs" aria-label="Inspector panels">
          <button
            :for={
              {tab, label} <- [
                {:files, "All files"},
                {:changes, "Changes"},
                {:checks, "Checks"},
                {:preview, "Previews"}
              ]
            }
            class={if @panel.tab == tab, do: "selected", else: "ghost"}
            phx-click="panel"
            phx-value-name={tab}
          >
            {label}
          </button>
        </nav>
        <div class="workspace-panel">
          <button class="ghost" phx-click="refresh-panel" disabled={@panel.busy?}>Refresh</button>
          <p :if={@panel.busy?} role="status">Loading…</p>
          <p :if={@panel.error} role="alert">{@panel.error}</p>
          <.panel_body :if={@panel.data} data={@panel.data} file={@panel.file} project={@project} />
          <div :if={@panel.tab == :preview && @preview}>
            <p>Status: {@preview.state}</p>
            <p :if={@preview.unavailable_reason}>{@preview.unavailable_reason}</p>
            <div class="workspace-actions">
              <button
                :for={action <- ~w(open restart stop logs)}
                class="ghost"
                phx-click="preview"
                phx-value-action={action}
                disabled={@panel.busy?}
              >
                {String.capitalize(action)}
              </button>
            </div>
            <a
              :if={@preview_url}
              href={~p"/preview/#{@track_id}"}
              target="_blank"
              rel="noreferrer"
            >
              Open preview in new tab ↗
            </a>
            <iframe
              :if={@preview_url}
              src={@preview_url}
              title="Track preview"
              class="workspace-preview"
              sandbox="allow-scripts allow-forms allow-same-origin allow-popups allow-downloads"
            ></iframe>
            <pre :if={@preview.logs}>{@preview.logs}</pre>
            <details>
              <summary>Preview configuration</summary>
              <.form
                :let={f}
                for={@preview_form}
                id="preview-config-form"
                phx-submit="preview-config"
              >
                <.input field={f[:directory]} id="preview-directory" label="App directory" />
                <.input
                  field={f[:command]}
                  id="preview-command"
                  label="Command (must honor $PORT)"
                />
                <.input field={f[:readiness_path]} id="preview-path" label="Readiness path" />
                <button class="primary">Save</button><button
                  class="ghost"
                  name="clear"
                  value="true"
                >Use project defaults</button>
              </.form>
            </details>
          </div>
          <p :if={@pull}>
            <a href={@pull.url} target="_blank" rel="noreferrer">View pull request ↗</a>
          </p>
        </div>
        <.live_component
          module={RavixWeb.Live.MachineDock}
          id="machine-dock-panel"
          track_id={@track_id}
          workdir={@track.workdir}
          current_user={@current_user}
          session_hash={@session_hash}
        />
      </aside>
    </div>
    <.dialog :if={@dialog == :rename} id="rename-dialog" title="Rename track" on_close="dismiss">
      <p class="hint">Changes only the display title. The Git branch stays fixed.</p>
      <.form :let={f} for={@rename_form} id="rename-form" phx-submit="rename">
        <.input field={f[:title]} id="rename-title" label="Display title" required />
        <button class="primary">
          Save
        </button>
      </.form>
    </.dialog>
    <.dialog :if={@dialog == :close} id="close-dialog" title="Close track" on_close="dismiss">
      <p>
        This closes the track for everyone and removes its worktree. Commit and push work you want to keep first.
      </p>
      <form id="close-form" phx-submit="close">
        <.input
          name="force"
          id="close-force"
          type="checkbox"
          label="Discard uncommitted changes"
          value={false}
        /><button class="danger" phx-disable-with="Closing…">Close track</button>
      </form>
    </.dialog>
    <.live_component
      :if={@dialog == :people}
      module={RavixWeb.Live.PeopleDialog}
      id="track-people"
      scope={:track}
      subject_id={@track_id}
      owner={@track.role == :owner}
      current_user={@current_user}
      session_hash={@session_hash}
    />
    <.dialog :if={@dialog == :pull} id="pull-dialog" title="Open pull request" on_close="dismiss">
      <p>Commit and push your branch before opening a pull request.</p>
      <form id="pull-form" phx-submit="open-pull">
        <.input name="title" id="pull-title" label="Title" value={@track.title} required /><.input
          name="base"
          id="pull-base"
          label="Base branch"
          value={@project.default_branch || "main"}
          required
        /><.input name="body" id="pull-body" type="textarea" label="Description" value="" /><.input
          name="draft"
          id="pull-draft"
          type="checkbox"
          label="Draft pull request"
          value={true}
        /><button class="primary" phx-disable-with="Opening…" disabled={:pull in @pending}>
          Open pull request
        </button>
      </form>
    </.dialog>
  </div>
</div>
