<div class="track-workspace">
  <%!-- No toasts here: this page's flash goes up to the workspace, which
    draws the one stack for the whole page. See `RavixWeb.Live.Result.flash/3`. --%>
  <%!-- The wait before the track's own detail lands, drawn in the shape the
  track itself will have rather than as a word in the middle of an empty
  page. The two columns and the header strip are what the layout is; leaving
  them out meant every track switch collapsed the page to one centred line
  and then reflowed it back, which read as the whole screen reloading even
  once the wait behind it got short. --%>
  <div :if={@loading && is_nil(@track)} class="track-workspace-body" aria-busy="true">
    <header class="crumbs track-crumbs"></header>
    <div class="split">
      <section class="track-conversation" aria-label="Conversation">
        <div class="transcript-scroll">
          <p class="workspace-welcome" role="status">Loading track…</p>
        </div>
      </section>
      <aside class="inspector" aria-label="Track inspector"></aside>
    </div>
  </div>
  <div :if={!@loading && is_nil(@track)} class="workspace-welcome">
    <p>Could not load this track.</p>
    <button class="primary" phx-click="retry-load">Try again</button>
  </div>
  <div :if={@track} class="track-workspace-body" data-narrow-view={@narrow_view}>
    <%!-- Two groups either side of the spacer: what the track is on the
      left, how it is on the right beside the actions. The status half is
      where anything that arrives late (the plan chip) or changes length
      (the machine's state) lives, so it grows into the spacer and never
      moves the title. When the strip is short the status chips give way
      first, down to their icon or count, then the branch, and the title
      last; see "the track's own header" in app.css, and HeaderFit for
      why a chip's words show whole or not at all. --%>
    <header id="track-header" class="crumbs track-crumbs" phx-hook="HeaderFit">
      <div class="track-header-path">
        <.link
          navigate={"/p/#{@project.id}"}
          class={["project-crumb", !fits?(@project.display_name, 12) && "long"]}
        >
          <span class="project-mark" aria-hidden="true">
            {String.first(@project.name) |> String.upcase()}
          </span>
          <strong><.project_name project={@project} /></strong>
        </.link>
        <span class="dimmer" aria-hidden="true">›</span>
        <button
          :if={owner_or_creator?(@current_user, @track)}
          class={["ghost track-title-crumb", !fits?(@track.title, 16) && "long"]}
          phx-click={JS.push_focus() |> JS.push("dialog")}
          phx-value-name="rename"
          title="Rename track"
          aria-label={"Rename track: #{@track.title}"}
        >
          {@track.title}
        </button>
        <strong
          :if={!owner_or_creator?(@current_user, @track)}
          class={["track-title-crumb", !fits?(@track.title, 16) && "long"]}
          title={@track.title}
        >{@track.title}</strong>
        <%!-- A new track is titled with its branch, so the chip appears only
          once the two say different things: after a rename, say. --%>
        <span
          :if={@track.branch != @track.title}
          class="chip mono track-branch"
          title={@track.branch}
        >{@track.branch}</span>
      </div>
      <span class="spacer"></span>
      <div class="track-header-status">
        <.live_component
          module={RavixWeb.Live.TrackPlanItems}
          id={"track-plan-items-#{@track.id}"}
          current_user={@current_user}
          session_hash={@session_hash}
          track_id={@track.id}
          summary={@assigned_plan}
        />
        <span :if={@track.visibility == :private} class="chip" title="Private">
          <.icon name="lock" /><span class="chip-label" data-fit-label>Private</span>
        </span>
        <.machine_chip machine={machine(@track, @threads, @thread_states, @setup_now)} />
        <span
          :if={
            @track.sandbox_layout == :dedicated ||
              Ravix.Config.dedicated_opens_enabled?(@current_user)
          }
          class="chip"
          id="track-machine-scope"
          title={machine_scope(@track)}
        ><.icon name="machine" size={12} /><span class="chip-label" data-fit-label>{machine_scope(
          @track
        )}</span></span>
        <span
          :if={@track.billing == :creator}
          id="track-payer"
          class="dim status-note"
          title={payer_label(@track)}
        >
          {payer_label(@track)}
        </span>
        <span
          :if={@track.billing != :creator && @project.role != :owner}
          id="track-agent-owner"
          class="dim status-note"
          title={agent_owner_label(@project, @track)}
        >
          {agent_owner_label(@project, @track)}
        </span>
      </div>
      <button
        :if={
          Ravix.People.workspace_sharing?(@project) && owner_or_creator?(@current_user, @track)
        }
        id="track-share-button"
        class="ghost"
        phx-click={JS.push_focus() |> JS.push("dialog")}
        phx-value-name="people"
        aria-haspopup="dialog"
        title={"Share track (#{length(@present)} viewing now)"}
      ><.icon name="add-person" size={15} /><span>Share</span><span
        class="dim"
        aria-label={"#{length(@present)} viewing now"}
      >{length(@present)}</span></button><button
        :if={!Ravix.People.workspace_sharing?(@project)}
        class="ghost"
        phx-click={JS.push_focus() |> JS.push("dialog")}
        phx-value-name="people"
        aria-label={"Track sharing (#{length(@present)} viewing now)"}
        title={"Track sharing (#{length(@present)} viewing now)"}
      ><.icon name="add-person" size={15} /><span>{length(@present)}</span></button>
      <button
        :if={rebuildable?(@current_user, @track)}
        class="ghost icon-button"
        aria-label="Rebuild machine"
        title="Rebuild machine"
        phx-click={JS.push_focus() |> JS.push("dialog")}
        phx-value-name="rebuild"
      >
        <.icon name="refresh" size={15} />
      </button>
      <button
        :if={owner_or_creator?(@current_user, @track)}
        class="ghost icon-button"
        aria-label="Close track"
        title="Close track"
        phx-click={JS.push_focus() |> JS.push("dialog")}
        phx-value-name="close"
      >
        <.icon name="x" size={15} />
      </button>
    </header>
    <nav class="track-view-switch workspace-tabs" aria-label="Track views">
      <button
        :for={
          {name, label} <- [
            {"conversation", "Conversation"},
            {"files", "Files"},
            {"terminal", "Commands"}
          ]
        }
        class={if @narrow_view == name, do: "selected", else: "ghost"}
        aria-pressed={to_string(@narrow_view == name)}
        phx-click="narrow-view"
        phx-value-name={name}
      >{label}</button>
    </nav>
    <div class="split">
      <section class="track-conversation" aria-label="Conversation">
        <%!-- `data-track` is how the scroll hook learns it is somewhere new.
          This element keeps its id across a track switch now --- the page
          moves rather than being rebuilt --- so without it a reader who had
          scrolled up in one track would arrive part-way up the next one. See
          `assets/js/hooks/transcript_tail.js`. --%>
        <.thread_tabs
          threads={@threads}
          states={@thread_states}
          thread_id={@thread_id}
          draft={@thread_draft}
          adding={@track.sandbox_layout == :dedicated and @track.sandbox_state != :ready}
          enabled={Ravix.Config.threads_enabled?()}
        />
        <div
          id="transcript-scroll"
          role={if length(@threads) > 1 or Ravix.Config.threads_enabled?(), do: "tabpanel"}
          aria-labelledby={
            if length(@threads) > 1 or Ravix.Config.threads_enabled?(),
              do:
                if(@thread_draft[:selected?],
                  do: "thread-tab-draft",
                  else: "thread-tab-#{@thread_id}"
                )
          }
          tabindex="0"
          phx-hook="TranscriptTail"
          class="transcript-scroll"
          data-track={
            if @thread_draft[:selected?], do: "draft-#{@thread_draft.id}", else: @thread_id
          }
        >
          <div class="track-ribbon">
            <p :if={@header && @header.copy_of} class="track-copy">
              You are in a copy of {@header.copy_of} called
              <code>{Path.basename(@track.workdir)}</code>
            </p>
            <div class="ribbon-line">
              <.icon name="folder" size={13} /><span>Branch <code>{@track.branch}</code></span>
            </div>
            <span
              :if={@track.stale}
              class="chip"
            >
              Settings changed — open a new track to use them
            </span>
          </div>
          <%!-- A draft has no transcript: the thread it will be does not exist
            until its first message, which is what this says. --%>
          <div
            :if={@thread_draft[:selected?]}
            id="draft-thread-empty"
            class="workspace-welcome conversation-start"
          >
            <span class="empty-icon"><.icon name="sparkle" size={22} /></span>
            <h2>New thread</h2>
            <p>Your first message starts this thread.</p>
            <p class="hint">
              Threads share this checkout and can run concurrently. Coordinate edits to avoid collisions.
            </p>
          </div>
          <button
            :if={!@thread_draft[:selected?] && Transcript.History.more?(@page.history)}
            id="load-earlier"
            type="button"
            phx-click="load-earlier"
            disabled={@earlier_loading}
          >
            {if @earlier_loading, do: "Loading earlier…", else: "Load earlier"}
          </button>
          <div
            :if={!@thread_draft[:selected?] && leading_comments(assigns) != []}
            id="transcript-leading-comments"
          >
            <.thread_comment
              :for={comment <- leading_comments(assigns)}
              comment={comment}
              current_user={@current_user}
              editing={@comment_editing}
            />
          </div>
          <div :if={!@thread_draft[:selected?]} id="transcript-turns" phx-update="stream">
            <article :for={{dom_id, turn} <- @streams.turns} id={dom_id} class="workspace-turn">
              <.prompt_message
                :if={turn.prompt || turn.image_count > 0}
                prompt={turn.prompt || ""}
                image_count={turn.image_count}
                track_id={@track.id}
                thread_id={@thread_id}
                turn_id={turn.id}
              />
              <section :if={turn.blocks != []} class="agent-terminal" aria-label="Agent output">
                <div class="agent-terminal-output">
                  <%= for segment <- segments(turn.blocks) do %>
                    <.work
                      :if={match?({:work, _}, segment)}
                      blocks={elem(segment, 1)}
                      turn={turn}
                      rendered={@rendered}
                      workdir={@track.workdir}
                    />
                    <div :if={match?({:block, _}, segment)}>
                      <.block
                        block={elem(segment, 1)}
                        html={rendered(@rendered, elem(segment, 1))}
                      />
                    </div>
                  <% end %>
                </div>
                <button
                  :if={
                    turn.prompt && !String.starts_with?(turn.prompt, "[ravix]") &&
                      Enum.any?(turn.blocks, &match?(%TranscriptBlock.Failure{}, &1))
                  }
                  type="button"
                  class="ghost"
                  phx-click="retry-turn"
                  phx-value-turn={turn.id}
                >Retry message</button>
                <.turn_footer :if={turn.settled?} turn={turn} workdir={@track.workdir} />
                <.turn_timer :if={!turn.settled?} turn={turn} />
              </section>
              <.thread_comment
                :for={comment <- comments_after(@comments, turn.id)}
                comment={comment}
                current_user={@current_user}
                editing={@comment_editing}
              />
            </article>
          </div>
          <%!-- Shown by `assets/js/hooks/transcript_tail.js` once the reader
            has scrolled up: it toggles `unpinned` on the scroller, and the
            stylesheet shows this only under that class. A click re-pins. --%>
          <button type="button" class="jump-latest" data-jump-latest>
            <.icon name="arrow-down" size={12} class="ico" />Jump to latest
          </button>
          <p
            :if={!@thread_draft[:selected?] && @transcript_loading}
            class="workspace-welcome"
            role="status"
          >
            Loading conversation…
          </p>
          <%!-- Only once the transcript has actually been read. An empty
            `@page` is also what a track that is still loading one has, and
            offering the starters for a conversation with a year of history
            in it --- for the moment before the read answers --- is a worse
            answer than saying nothing yet. --%>
          <div
            :if={
              !@thread_draft[:selected?] && !@transcript_loading &&
                Transcript.visible_turns(@page) == []
            }
            class="workspace-welcome conversation-start"
          >
            <span class="empty-icon"><.icon name="sparkle" size={22} /></span>
            <h2>What are we working on?</h2>
            <div class="conversation-starters">
              <button
                :for={starter <- @starters}
                class="ghost"
                phx-click="starter"
                phx-value-prompt={starter.prompt}
              >
                {starter.label}
              </button>
            </div>
          </div>
        </div>
        <div :if={!@thread_draft[:selected?] && @queue != []} class="workspace-queue">
          <div :for={item <- @queue}>
            <span class="chip">{queue_label(item.status)}</span>
            <div :if={item.prompt} class="queue-prompt md">{queue_prompt_html(item.prompt)}</div>
            <p
              :if={queue_feedback(item, @track.runtime || @project.runtime)}
              class="queue-feedback"
            >
              {queue_feedback(item, @track.runtime || @project.runtime)}
            </p>
            <span :if={item.error && item.status != :queued}>{item.error}</span>
            <button
              :if={item.can_cancel}
              class="ghost"
              phx-click="queue"
              phx-value-action="cancel"
              phx-value-id={item.id}
            >
              Cancel
            </button>
            <button
              :if={item.can_cancel && item.status in [:failed, :unconfirmed]}
              class="ghost"
              phx-click="queue"
              phx-value-action="retry"
              phx-value-id={item.id}
            >
              Retry
            </button>
          </div>
        </div>
        <%!-- The one thing a reader who is not looking should hear: a turn
          ended. Polite, so it waits for whatever is being read; visually
          hidden, because the transcript already shows it. --%>
        <div id="transcript-status" class="sr-only" role="status" aria-live="polite">
          {@announcement}
        </div>
        <.loading_status :if={:interrupt in @pending}>Stopping agent…</.loading_status>
        <div
          :if={@track.setup_state != "ready"}
          id="track-setup-status"
          role={if @track.status == :setup_failed, do: "alert", else: "status"}
        >
          <strong>{setup_label(@track, @setup_now)}</strong>
          <span :if={
            @track.sandbox_layout == :dedicated ||
              Ravix.Config.dedicated_opens_enabled?(@current_user)
          }>{if @track.sandbox_layout == :dedicated,
            do: "Own machine",
            else: "Shared project machine"}</span>
          <span :if={@track.setup_error}>{@track.setup_error}</span>
          <p :if={@track.setup_state in ["pending", "running", "retry"] and not parked?(@track)}>
            Prompts will wait until setup is ready.
          </p>

          <p :if={@track.status == :setup_failed && @track.setup_error_code != "secrets_changed"}>
            Retry setup, then retry your saved prompts.
          </p>
          <button
            :if={
              @track.setup_error_code == "secrets_changed" &&
                rebuildable?(@current_user, @track)
            }
            id="secrets-changed-rebuild"
            phx-click={JS.push_focus() |> JS.push("dialog")}
            phx-value-name="rebuild"
          >
            Rebuild machine…
          </button>
        </div>
        <div :if={@billing_notice} id="billing-notice" class="welcome-warning" role="status">
          <p>{@billing_notice}</p>
          <button type="button" class="ghost" phx-click="dismiss-billing-notice">Got it</button>
        </div>
        <.loading_status :if={:retry in @pending}>Retrying track…</.loading_status>
        <.loading_status :if={@thread_draft[:selected?] && :thread_options in @pending}>
          Loading agents…
        </.loading_status>
        <RavixWeb.Live.ThreadConnect.panel
          :if={@thread_draft[:selected?]}
          options={@thread_draft.options}
          connection={@thread_connect}
          current_user={@current_user}
          session_hash={@session_hash}
        />
        <p :if={@thread_error} id="thread-error" role="alert">{@thread_error}</p>
        <.loading_status :if={:start_thread in @pending}>Starting thread…</.loading_status>
        <div class="workspace-composer">
          <.live_component
            :if={!@thread_draft[:selected?]}
            module={RavixWeb.Live.AgentHealth}
            id="track-agent-health"
            track_id={@track.id}
            thread_id={@thread_id}
            current_user={@current_user}
            session_hash={@session_hash}
            project_id={@project.id}
            refused={
              @agent_refused ||
                @track.setup_error_code in [
                  "inference_credential_unusable",
                  "chatgpt_grant_unusable"
                ] ||
                Enum.any?(
                  @queue,
                  &(&1.status == :failed &&
                      &1.error_code in ["inference_credential_unusable", "chatgpt_grant_unusable"])
                )
            }
            refresh={@health_refresh}
          />
          <p :for={person <- Enum.filter(@present, & &1.typing)} class="hint">
            @{person.login} is typing…
          </p>
          <%!-- `phx-change` is what `allow_upload/3` needs to see an image
            being chosen, and the textarea's own share of it is a round trip
            per keystroke carrying the whole prompt --- which `handle_event`
            for "validate" looks at and does nothing with. A long instruction
            was sent over the socket once per character typed. `blur` is the
            debounce that says what is true: the server has no use for this
            box until it is submitted, and the draft is kept in the browser
            by `assets/js/hooks/composer.js` meanwhile. --%>
          <%!-- Ask agent / Comment. A comment goes to people and never to
            the agent, so the whole box says which one it is: its colour, its
            placeholder, its accessible name and the send button's. Images
            are for prompts; any already attached wait for Ask agent. --%>
          <form id="composer-form" phx-submit="send" phx-change="validate">
            <div
              class={["composer-box", @composer_mode == :comment && "commenting"]}
              data-composer-box
            >
              <div class="composer-note" role="status" data-composer-note hidden></div>
              <p
                :if={@track.level == :read && @composer_mode == :ask}
                id="composer-read-only"
                class="composer-mode-hint composer-read-only"
              >
                <.icon name="person" size={12} />You have Read access. Ask an admin for Write to send prompts; you can still comment.
              </p>
              <p
                :if={@composer_mode == :comment}
                id="composer-mode-hint"
                class="composer-mode-hint"
              >
                <.icon name="person" size={12} />Comment — not sent to the agent
              </p>
              <textarea
                :if={@thread_draft[:selected?]}
                id={"composer-draft-#{@thread_draft.id}"}
                phx-hook="Composer"
                name="text"
                rows="2"
                phx-debounce="blur"
                placeholder="Start a new thread. @mention files…"
                aria-label="Message"
                aria-autocomplete="list"
                aria-controls="composer-suggestions"
                aria-keyshortcuts="Control+L Meta+L"
                data-draft-key={"track:#{@track.id}:thread:draft:#{@thread_draft.id}"}
                data-typing-event="typing"
                data-files-event="mention-files"
                disabled={is_nil(@track.conversation_id) or @track.level == :read}
              ></textarea>
              <textarea
                :if={!@thread_draft[:selected?]}
                id={"composer-#{@thread_id}"}
                phx-hook="Composer"
                name="text"
                rows="2"
                phx-debounce="blur"
                placeholder={composer_placeholder(@composer_mode, @page)}
                aria-label={if @composer_mode == :comment, do: "Comment", else: "Message"}
                aria-describedby={
                  (@composer_mode == :comment && "composer-mode-hint") ||
                    (@track.level == :read && "composer-read-only")
                }
                aria-autocomplete="list"
                aria-controls={
                  if @composer_mode == :comment,
                    do: "mention-options",
                    else: "composer-suggestions"
                }
                aria-keyshortcuts="Control+L Meta+L"
                data-mode={@composer_mode}
                data-draft-key={"track:#{@track.id}:thread:#{@thread_id}"}
                data-typing-event="typing"
                data-files-event={@composer_mode == :ask && "mention-files"}
                data-commands={
                  @composer_mode == :ask &&
                    Jason.encode!(composer_commands(@agent_commands, @track, @pending))
                }
                disabled={
                  @composer_mode == :ask &&
                    (is_nil(@track.conversation_id) or @track.level == :read)
                }
              ></textarea>
              <ul
                :if={@composer_mode == :comment}
                id="mention-options"
                class="mention-options"
                role="listbox"
                aria-label="People to mention"
                phx-update="ignore"
                data-mention-options
              >
                <li
                  :for={person <- @mentionable}
                  id={"mention-option-#{person.login}"}
                  role="option"
                  aria-selected="false"
                  data-login={person.login}
                >
                  <strong>@{person.login}</strong>
                  <span :if={person.name} class="dim">{person.name}</span>
                </li>
              </ul>
              <%!-- Ask mode's `@` files and `/` commands. The hook fills the
                list, names it and opens it, so the server leaves it alone.
                Open is `hidden` rather than a `data-` flag: a patch strips
                any `data-` attribute from an ignored element that the
                template does not have, and keeps the rest. --%>
              <ul
                :if={@composer_mode == :ask}
                id="composer-suggestions"
                class="mention-options composer-suggestions"
                role="listbox"
                aria-label="Suggestions"
                phx-update="ignore"
                hidden
                data-composer-suggestions
              >
              </ul>
              <p
                :if={@composer_mode == :ask}
                id="composer-suggestions-status"
                class="sr-only"
                role="status"
                phx-update="ignore"
                data-composer-announce
              >
              </p>
              <.live_file_input upload={@uploads.images} aria-label="Attach images" />
              <div
                :for={entry <- @uploads.images.entries}
                :if={@composer_mode == :ask}
                class="workspace-upload"
              >
                <span>{entry.client_name} ({entry.progress}%)</span><button
                  type="button"
                  class="ghost"
                  phx-click="cancel-upload"
                  phx-value-ref={entry.ref}
                >Remove</button>
                <p :for={err <- upload_errors(@uploads.images, entry)} role="alert">
                  {upload_error(err)}
                </p>
              </div>
              <p
                :for={err <- upload_errors(@uploads.images)}
                :if={@composer_mode == :ask}
                role="alert"
              >
                {upload_error(err)}
              </p>
              <p :if={@attached_images != [] && @composer_mode == :ask}>
                {length(@attached_images)} attached image(s) retained for retry.
                <button type="button" class="ghost" phx-click="clear-attachments">
                  Remove retained images
                </button>
              </p>
              <div class="workspace-actions">
                <div
                  :if={!@thread_draft[:selected?]}
                  class="composer-mode"
                  role="group"
                  aria-label="Send to"
                >
                  <button
                    type="button"
                    id="composer-mode-ask"
                    aria-pressed={to_string(@composer_mode == :ask)}
                    phx-click="composer-mode"
                    phx-value-mode="ask"
                  >
                    Ask agent
                  </button>
                  <button
                    type="button"
                    id="composer-mode-comment"
                    aria-pressed={to_string(@composer_mode == :comment)}
                    phx-click="composer-mode"
                    phx-value-mode="comment"
                  >
                    Comment
                  </button>
                </div>
                <button
                  :if={@composer_mode == :ask}
                  type="button"
                  class="ghost"
                  aria-label="Choose images"
                  phx-click={JS.dispatch("click", to: "##{@uploads.images.ref}")}
                >
                  <.icon name="picture" size={17} />
                </button>
                <%!-- A draft's agent is still open, so it offers both; once the
                  thread exists only the model changes. The picks are part of
                  this form, and each change arrives as `validate`. --%>
                <div
                  :if={@thread_draft[:selected?] && @thread_draft.options}
                  id="draft-runtime"
                  class="draft-runtime"
                >
                  <RavixWeb.Live.RuntimePicker.fields
                    options={@thread_draft.options}
                    params={
                      %{
                        "runtime" => @thread_draft.runtime,
                        "model" => @thread_draft.model,
                        "preference_explicit" => to_string(@thread_draft.explicit?)
                      }
                    }
                    name="thread_draft"
                  />
                  <p class="hint draft-default-hint">Also your default for new threads</p>
                </div>
                <span
                  :if={
                    @composer_mode == :ask &&
                      (@track.billing == :creator || @project.role != :owner)
                  }
                  id="composer-payer"
                  class="dim composer-payer"
                >
                  {payer_label(@track)}
                </span>
                <.model_menu
                  :if={!@thread_draft[:selected?] && @composer_mode == :ask}
                  runtime={@track.runtime || @project.runtime}
                  model={@track.model || @track.default_model || @project.model}
                  project_model={
                    if is_nil(@track.runtime) or @track.runtime == @project.runtime,
                      do: @project.model
                  }
                  models={@models}
                  disabled={
                    is_nil(@track.conversation_id) or @track.status in [:running, :opening] or
                      :model in @pending or @track.level == :read
                  }
                /><span class="spacer"></span>
                <span
                  id="composer-shortcut"
                  class="composer-shortcut"
                  aria-hidden="true"
                  phx-update="ignore"
                  data-composer-shortcut
                >
                  <kbd>Ctrl+L</kbd> to focus
                </span>
                <button
                  type="submit"
                  class="primary composer-send"
                  aria-label={if @composer_mode == :comment, do: "Post comment", else: "Send"}
                  title={if @composer_mode == :comment, do: "Post comment", else: "Send"}
                  disabled={
                    (@composer_mode == :comment && @transcript_loading) ||
                      (@composer_mode == :ask &&
                         (is_nil(@track.conversation_id) or @track.level == :read or
                            (@thread_draft[:selected?] &&
                               (is_nil(@thread_draft.options) or :start_thread in @pending))))
                  }
                >
                  <.icon name="arrow-up" size={16} />
                </button>
                <button
                  :if={
                    !@thread_draft[:selected?] && @track.status in [:running, :opening] &&
                      @track.level != :read
                  }
                  type="button"
                  class="ghost"
                  phx-click="interrupt"
                  disabled={:interrupt in @pending}
                >
                  Stop
                </button>
                <button
                  :if={
                    parked?(@track) ||
                      (!@thread_draft[:selected?] &&
                         ((@track.setup_state == "failed" &&
                             @track.setup_error_code != "secrets_changed") ||
                            (@track.setup_state == "ready" && @track.status in [:failed, :opening])))
                  }
                  type="button"
                  class="ghost"
                  phx-click="retry-track"
                  disabled={:retry in @pending}
                >
                  {cond do
                    @track.status == :setup_failed -> "Retry setup"
                    parked?(@track) -> "Wake machine"
                    true -> "Wake / retry"
                  end}
                </button>
              </div>
            </div>
          </form>
        </div>
      </section>
      <aside id="inspector" class="inspector" aria-label="Track inspector">
        <div
          id="inspector-resize"
          phx-hook="PanelResize"
          class="panel-resize-handle right"
          role="separator"
          tabindex="0"
          aria-label="Inspector width"
          aria-orientation="vertical"
          data-var="--inspector-width"
          data-min="300"
          data-max="900"
          data-key="ravix.panel-width.right"
          data-side="right"
        >
        </div>
        <nav class="workspace-tabs" aria-label="Inspector panels">
          <button
            type="button"
            id="inspector-toggle"
            phx-hook="PanelToggle"
            class="ghost panel-toggle"
            data-panel="inspector"
            data-key="ravix.panel.inspector"
            data-hide-label="Hide inspector"
            data-show-label="Show inspector"
            aria-controls="inspector"
            aria-expanded="true"
            title="Hide inspector"
          >
            <.icon name="panel-right" size={16} />
            <span class="sr-only label-hide">Hide inspector</span>
            <span class="sr-only label-show">Show inspector</span>
          </button>
          <button
            :for={
              {tab, label} <- [
                {:files, "Files"},
                {:changes, "Changes"},
                {:checks, "Checks"},
                {:preview, "Preview"}
              ]
            }
            class={if @panel.tab == tab, do: "selected", else: "ghost"}
            phx-click="panel"
            phx-value-name={tab}
          >
            {label}<.change_badge :if={tab == :changes} count={@panel.change_count} />
          </button>
          <button
            class={["ghost panel-refresh", @panel.busy? && "busy"]}
            phx-click="refresh-panel"
            disabled={@panel.busy?}
            aria-label="Refresh"
            title="Refresh"
          >
            <.icon name="refresh" size={14} />
          </button>
        </nav>
        <div class="workspace-panel">
          <%= case inspector_state(@track, machine(@track, @threads, @thread_states, @setup_now), @panel) do %>
            <% {:setup, step} -> %>
              <%!-- The setup banner is the live region for these words. --%>
              <.empty pane busy id="panel-setup" icon="spinner" title={step} />
            <% :asleep -> %>
              <.asleep
                id="panel-asleep"
                can_wake={@track.level != :read}
                waking={:wake in @pending}
              />
            <% nil -> %>
              <%!-- A diff being re-read stays on screen; the refresh button turns instead. --%>
              <.loading_status :if={@panel.busy? && !is_struct(@panel.data, Ravix.Tracks.Diff)}>
                Loading inspector…
              </.loading_status>
              <.git_status
                :if={@panel.tab == :checks}
                git={@git}
                loading={@git_loading?}
                checks={match?(%Ravix.GitHub.ChecksReport{}, @panel.data) && @panel.data}
                checks_error={@panel.error}
                project={@project}
                writing={if :git in @pending, do: @git_step}
                failure={@git_failure}
                can_wake={@track.level != :read}
                waking={:wake in @pending}
              />
              <p :if={@panel.error} role="alert">{@panel.error}</p>
              <.panel_body
                :if={@panel.data}
                data={@panel.data}
                show_ignored?={@show_ignored?}
                branch_merged?={@branch_merged?}
                directories={@panel.directories}
                metadata={@panel.metadata}
                file={@panel.file}
                project={@project}
                diff_path={@diff_path}
                diff_filter={@diff_filter}
                diff_show_large={@diff_show_large}
              />
              <.empty
                :if={
                  @panel.tab == :preview && @preview && @preview.state == :stopped &&
                    !@preview.error
                }
                pane
                id="preview-empty"
                icon="globe"
                title="No preview running"
                because={@preview.unavailable_reason}
              >
                <:action
                  id="preview-run"
                  label="Run"
                  click={JS.push("preview", value: %{action: "run"})}
                  disabled={@panel.busy? || !@preview.available}
                />
              </.empty>
              <div :if={@panel.tab == :preview && @preview}>
                <p :if={@preview.state != :stopped || @preview.error} id="run-status">
                  Status: {@preview.state}
                </p>
                <.loading_status :if={@preview.state == :starting} id="preview-loading">
                  {RavixWeb.PreviewPresentation.loading_label(@preview.config)}
                </.loading_status>
                <p
                  :if={@preview.error}
                  id="preview-error"
                  role="alert"
                  phx-mounted={JS.set_attribute({"open", ""}, to: "#preview-logs")}
                >
                  {@preview.error}
                </p>
                <p :if={
                  @preview.unavailable_reason && (@preview.state != :stopped || @preview.error)
                }>
                  {@preview.unavailable_reason}
                </p>
                <p :if={@preview.keeps_awake} id="run-keeps-awake" class="hint">
                  Keeps this track's machine awake while running
                </p>
                <div class="workspace-actions">
                  <button
                    :if={@preview.state != :stopped || @preview.error}
                    class="primary"
                    phx-click="preview"
                    phx-value-action="run"
                    disabled={
                      @panel.busy? || !@preview.available ||
                        @preview.state in [:starting, :ready, :running]
                    }
                  >
                    Run
                  </button>
                  <button
                    :if={@preview.url}
                    phx-click="preview"
                    phx-value-action="open"
                    disabled={@panel.busy? || !@preview.available}
                  >Open preview</button>
                  <button
                    :if={@preview.state in [:starting, :ready, :running]}
                    phx-click="preview"
                    phx-value-action="restart-run"
                    disabled={@panel.busy? || !@preview.available}
                  >
                    Restart
                  </button>
                  <button
                    :if={@preview.state != :stopped}
                    phx-click="preview"
                    phx-value-action="stop"
                    disabled={@panel.busy? || @preview.state == :stopped}
                  >
                    Stop
                  </button>
                  <button
                    phx-click={
                      JS.push("preview") |> JS.set_attribute({"open", ""}, to: "#preview-logs")
                    }
                    phx-value-action="logs"
                    disabled={@panel.busy?}
                  >
                    Logs
                  </button>
                </div>
                <a
                  :if={@preview_url && @preview.state == :ready}
                  href={~p"/preview/#{@track_id}"}
                  target="_blank"
                  rel="noreferrer"
                >
                  Open preview in new tab ↗
                </a>
                <iframe
                  :if={@preview_url && @preview.state == :ready}
                  src={@preview_url}
                  title="Track preview"
                  class="workspace-preview"
                  sandbox="allow-scripts allow-forms allow-same-origin allow-popups allow-downloads"
                ></iframe>
                <details
                  id="preview-logs"
                  open={@preview.state == :failed}
                  phx-mounted={JS.ignore_attributes(["open"])}
                >
                  <summary>Show logs</summary>
                  <pre>{RavixWeb.PreviewPresentation.logs(@preview.logs) |> then(&if(&1 == "", do: "No logs yet.", else: &1))}</pre>
                </details>
                <!-- Open by the reader, not by the server, and the same
            `ignore_attributes` as the logs above it: a status patch arriving
            while somebody is typing in here used to collapse the section
            under them. -->
                <details id="preview-config" phx-mounted={JS.ignore_attributes(["open"])}>
                  <summary>Run script override</summary>
                  <.form
                    :let={f}
                    for={@preview_form}
                    id="preview-config-form"
                    phx-submit="preview-config"
                  >
                    <.input field={f[:directory]} id="preview-directory" label="App directory" />
                    <.input
                      field={f[:command]}
                      id="preview-command"
                      label="Run command"
                    />
                    <.input
                      field={f[:readiness_path]}
                      id="preview-path"
                      label="Readiness path (optional)"
                    />
                    <.input
                      field={f[:stop_command]}
                      id="run-stop-command"
                      label="Stop command (optional)"
                    />
                    <p class="hint">
                      Leave readiness blank for a process without a preview. HTTP apps must honor $PORT and fail on a collision. Without a stop command, Stop signals the process group.
                    </p>
                    <button class="primary">Save</button><button
                      class="ghost"
                      name="clear"
                      value="true"
                    >Use project defaults</button>
                  </.form>
                </details>
              </div>
          <% end %>
          <p :if={@pull}>
            <a href={@pull.url} target="_blank" rel="noreferrer">View pull request ↗</a>
          </p>
        </div>
        <.live_component
          module={RavixWeb.Live.MachineDock}
          id="machine-dock-panel"
          lifecycle={
            if @track.sandbox_layout == :dedicated,
              do: {@track.conversation_id, @track.sandbox_state}
          }
          track_id={@track_id}
          machine={machine(@track, @threads, @thread_states, @setup_now)}
          workdir={@track.workdir}
          current_user={@current_user}
          session_hash={@session_hash}
          can_write={@track.level != :read}
          said={
            inspector_state(@track, machine(@track, @threads, @thread_states, @setup_now), @panel) !=
              nil || (@panel.tab == :checks && match?(%{asleep?: true}, @git))
          }
        />
      </aside>
    </div>
    <.dialog :if={@dialog == :rename} id="rename-dialog" title="Rename track" on_close="dismiss">
      <p class="hint">Changes only the display title. The Git branch stays fixed.</p>
      <.form :let={f} for={@rename_form} id="rename-form" phx-submit="rename">
        <.input field={f[:title]} id="rename-title" label="Display title" required />
        <button class="primary">
          Save
        </button>
      </.form>
    </.dialog>
    <.dialog :if={@dialog == :close} id="close-dialog" title="Close track" on_close="dismiss">
      <p>
        <%= if @track.sandbox_layout == :dedicated do %>
          This closes the track for everyone. This track's machine, its uncommitted changes and unpushed commits will be deleted. Commit and push work you want to keep first.
        <% else %>
          This closes the track for everyone and removes its worktree. Commit and push work you want to keep first.
        <% end %>
      </p>
      <.machine_changes
        :if={@track.sandbox_layout == :dedicated}
        id="close-machine-changes"
        info={@close_info}
      />
      <form id="close-form" phx-submit="close">
        <.input
          name="force"
          id="close-force"
          type="checkbox"
          label={
            if @track.sandbox_layout == :dedicated,
              do: "Delete machine, uncommitted changes and unpushed commits",
              else: "Discard uncommitted changes"
          }
          value={false}
        /><button class="danger" phx-disable-with="Closing…">Close track</button>
      </form>
    </.dialog>
    <.dialog
      :if={@dialog == :rebuild}
      id="rebuild-dialog"
      title="Rebuild machine"
      on_close="dismiss"
    >
      <p :if={@track.setup_error_code == "secrets_changed"}>
        This track's secrets changed. Rebuilding gives it a new machine with the current secrets.
      </p>
      <p>
        Rebuilding deletes only this track's machine, its uncommitted changes and unpushed commits. Sibling tracks are unaffected. Commit and push work you want to keep first.
      </p>
      <.machine_changes id="rebuild-machine-changes" info={@close_info} />
      <form id="rebuild-track-machine" phx-submit="rebuild-machine">
        <.input
          name="force"
          id="rebuild-force"
          type="checkbox"
          label="Delete machine, uncommitted changes and unpushed commits"
          value={false}
          required
        /><button class="danger" phx-disable-with="Rebuilding…">Rebuild machine</button>
      </form>
    </.dialog>
    <.live_component
      :if={
        @dialog == :people && Ravix.People.workspace_sharing?(@project) &&
          owner_or_creator?(@current_user, @track)
      }
      module={RavixWeb.Live.ShareDialog}
      id="track-share"
      track_id={@track_id}
      current_user={@current_user}
      session_hash={@session_hash}
    />
    <.live_component
      :if={@dialog == :people && !Ravix.People.workspace_sharing?(@project)}
      module={RavixWeb.Live.PeopleDialog}
      id="track-people"
      scope={:track}
      project={@project}
      subject_id={@track_id}
      track={@track}
      current_user={@current_user}
      session_hash={@session_hash}
    />
    <.dialog
      :if={@dialog == :commit}
      id="commit-dialog"
      title="Commit and push"
      on_close="dismiss"
    >
      <p>
        Stages every change in this track's worktree, commits it and pushes the branch to GitHub.
      </p>
      <form id="commit-form" phx-submit="commit-push">
        <.input
          name="message"
          id="commit-message"
          type="textarea"
          label="Commit message"
          value={@commit_message}
          maxlength={Ravix.Tracks.Git.message_max()}
          required
        />
        <p :if={@git_failure} id="commit-failure" class="git-failure" role="alert">
          <span>{@git_failure}</span>
        </p>
        <.loading_status :if={:git in @pending}>Committing and pushing…</.loading_status>
        <button class="primary" phx-disable-with="Committing…" disabled={:git in @pending}>
          Commit and push
        </button>
      </form>
    </.dialog>
    <.dialog :if={@dialog == :pull} id="pull-dialog" title="Open pull request" on_close="dismiss">
      <p>Commit and push your branch before opening a pull request.</p>
      <form id="pull-form" phx-submit="open-pull">
        <.input name="title" id="pull-title" label="Title" value={@track.title} required /><.input
          name="base"
          id="pull-base"
          label="Base branch"
          value={@project.default_branch || "main"}
          required
        /><.input name="body" id="pull-body" type="textarea" label="Description" value="" /><.input
          name="draft"
          id="pull-draft"
          type="checkbox"
          label="Draft pull request"
          value={true}
        />
        <.loading_status :if={:pull in @pending}>Opening pull request…</.loading_status>
        <button class="primary" phx-disable-with="Opening…" disabled={:pull in @pending}>
          Open pull request
        </button>
      </form>
    </.dialog>
  </div>
</div>
