{
  "name": "switchyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parallel tracks on one cloud machine. Sign in with GitHub, pick a repository, and every piece of work is its own git worktree with its own agent conversation. The server owns the Fountain account.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && bun build server/index.ts --target=bun --outfile=dist-server/index.js",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "mock": "bun mock/server.ts",
    "server": "STATIC_DIR= DATA_DIR=./data bun --watch server/index.ts",
    "start": "bun server/index.ts"
  },
  "dependencies": {
    "@managoat/fountain-app": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici-node": "npm:undici@7.29.1",
    "ws-node": "npm:ws@8.21.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "8.18.1",
    "@types/ws-node": "npm:@types/ws@8.18.1",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
