#!/bin/sh
# Read by every `bin/ravix` command, including `bin/server` and `bin/migrate`.
#
# Render publishes every instance of a service under RENDER_DISCOVERY_SERVICE, a
# DNS name whose A records are the instances' private addresses, and gives each
# instance one of those addresses. Two consequences, and this file exists for
# both:
#
#   * distribution has to be by `name`. The release default is `sname`, which
#     reaches only its own host, so two instances would each be a cluster of one
#     and every per-track process would exist twice (ADR 0003).
#
#   * the node name has to be `<%= @release.name %>@<that address>`, because
#     `DNSCluster` resolves the query to addresses and dials this release's own
#     basename at each of them. A hostname here instead of an address would
#     resolve nowhere from a sibling instance.
#
# Off anywhere else -- a local `bin/server`, the browser suite, CI's Docker
# cutover check -- so those keep the release's `sname` default and one node.
if [ -n "$RENDER_DISCOVERY_SERVICE" ]; then
  # `hostname -i` is the address Render routes to, and prints several when the
  # container also has an IPv6 one. Trimmed to the first with shell parameter
  # expansion rather than awk or cut: the runner image is debian-slim, which has
  # `hostname` but no awk, and this file is sourced by `bin/ravix`, so `set --`
  # to split the words would clobber the launcher's own arguments.
  RELEASE_IP="$(hostname -i 2>/dev/null)"
  RELEASE_IP="${RELEASE_IP%% *}"

  if [ -n "$RELEASE_IP" ]; then
    export RELEASE_DISTRIBUTION=name
    export RELEASE_NODE="<%= @release.name %>@$RELEASE_IP"
  else
    # Said out loud rather than swallowed: the alternative is an instance that
    # boots, serves, and quietly runs its own follower for every open track.
    echo "ravix: RENDER_DISCOVERY_SERVICE is set but this container has no address from \`hostname -i\`; staying single-node and NOT clustering." >&2
  fi
fi
